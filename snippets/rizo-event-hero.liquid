{%- comment -%}
  RIZO EVENT LAYER — hero atmosphere slot (moon + hero fog).

  Render as a direct child of a positioned hero:
    {% render 'rizo-event-hero' %}

  The wrapper is absolutely positioned with z-index: auto, so it does not
  create a stacking context: the moon and fog layers interleave with the
  hero's own layers (camo, logo marks, copy) through their z-index tokens.
  Everything here is aria-hidden and pointer-events: none.
{%- endcomment -%}
{%- if settings.event_layer != blank and settings.event_layer != 'off' -%}
  {%- capture ev_moon -%}{% render 'rizo-event-value', key: 'feature', feature: 'moon' %}{%- endcapture -%}
  {%- capture ev_fog -%}{% render 'rizo-event-value', key: 'feature', feature: 'fog' %}{%- endcapture -%}
  {%- if ev_moon == 'true' or ev_fog == 'true' -%}
    {%- capture ev_moon_src -%}{% render 'rizo-event-value', key: 'moon_src' %}{%- endcapture -%}
    {%- capture ev_moon_ratio -%}{% render 'rizo-event-value', key: 'moon_ratio' %}{%- endcapture -%}
    {%- capture ev_fog_layers -%}{% render 'rizo-event-value', key: 'hero_fog_layers' %}{%- endcapture -%}
    {%- liquid
      assign ev_moon_src = ev_moon_src | strip
      assign ev_moon_ratio = ev_moon_ratio | strip | default: 1 | plus: 0
      if ev_moon_ratio <= 0
        assign ev_moon_ratio = 1
      endif
      assign ev_moon_height = 1000 | divided_by: ev_moon_ratio | round
      assign ev_fog_layers = ev_fog_layers | strip | default: 2 | plus: 0 | at_most: 4
    -%}
    <div class="rizo-event-hero" data-rizo-event-hero aria-hidden="true">
      {%- if ev_fog == 'true' and ev_fog_layers > 0 -%}
        <div class="rizo-event-fog rizo-event-fog--hero rizo-event-fog--l1"><div class="rizo-event-fog-strip"></div></div>
      {%- endif -%}
      {%- if ev_moon == 'true' and ev_moon_src != blank -%}
        <div class="rizo-event-moon rizo-event-moon--{{ settings.event_moon_layer | default: 'behind' }}" data-rizo-event-moon{% unless settings.event_moon_motion %} data-static{% endunless %}>
          <span class="rizo-event-moon-glow"></span>
          <div class="rizo-event-moon-body">
            <img class="rizo-event-moon-art" src="{{ ev_moon_src }}" width="1000" height="{{ ev_moon_height }}" alt="" loading="eager" decoding="async" fetchpriority="low" draggable="false">
          </div>
        </div>
      {%- endif -%}
      {%- if ev_fog == 'true' and ev_fog_layers > 1 -%}
        {%- for i in (2..ev_fog_layers) -%}
          <div class="rizo-event-fog rizo-event-fog--hero rizo-event-fog--l{{ i }}"><div class="rizo-event-fog-strip"></div></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
