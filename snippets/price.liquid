{%- assign target = product.selected_or_first_available_variant | default: product -%}
<div class="pdp-price"{% if context == 'product' %} data-product-price{% endif %}>
  <span>{{ target.price | money }}</span>
  {%- if target.compare_at_price > target.price -%}
    <s{% if context == 'product' %} data-product-compare{% endif %}>{{ target.compare_at_price | money }}</s>
  {%- elsif context == 'product' -%}
    <s data-product-compare hidden></s>
  {%- endif -%}
  {%- if context == 'product' %}{{ form | payment_terms }}{% endif -%}
</div>
