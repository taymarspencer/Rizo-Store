{% liquid
  assign icon_name = name | default: 'spark'
  assign icon_class = class | default: ''
%}
<svg class="icon {{ icon_class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {% case icon_name %}
    {% when 'menu' %}<path d="M4 7h16M4 12h16M4 17h16"/>
    {% when 'close' %}<path d="m6 6 12 12M18 6 6 18"/>
    {% when 'search' %}<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>
    {% when 'bag' %}<path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/>
    {% when 'home' %}<path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10M9 20v-6h6v6"/>
    {% when 'shop' %}<path d="M4 9h16l-1 11H5L4 9Z"/><path d="m7 9 1-5h8l1 5"/>
    {% when 'arrow' %}<path d="M5 12h14M14 7l5 5-5 5"/>
    {% when 'plus' %}<path d="M12 5v14M5 12h14"/>
    {% when 'minus' %}<path d="M5 12h14"/>
    {% when 'sound' %}<path d="M5 10v4h3l4 3V7L8 10H5Z"/><path d="M16 9a4 4 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"/>
    {% when 'pin' %}<path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/>
    {% when 'heart' %}<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.7-7.5 1.1-1.1a5.5 5.5 0 0 0 0-7.8Z"/>
    {% when 'check' %}<path d="m5 12 4 4L19 6"/>
    {% else %}<path d="m12 2 1.7 6.3L20 10l-6.3 1.7L12 18l-1.7-6.3L4 10l6.3-1.7L12 2Z"/>
  {% endcase %}
</svg>
