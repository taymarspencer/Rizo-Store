<div class="overlay-shell" id="RizoSearch" data-overlay="search" hidden>
  <button class="overlay-backdrop" type="button" data-overlay-close tabindex="-1" aria-hidden="true" aria-label="Close search"></button>
  <section class="search-dialog" role="dialog" aria-modal="true" aria-labelledby="SearchTitle" data-predictive-search data-predictive-url="{{ routes.predictive_search_url }}">
    <div class="search-dialog-inner">
      <div class="search-dialog-top"><h2 id="SearchTitle">Search</h2><button class="icon-btn" type="button" data-overlay-close aria-label="Close search">{% render 'icon', name: 'close' %}</button></div>
      <form class="search-form" action="{{ routes.search_url }}" method="get" role="search" data-predictive-form>
        <label class="visually-hidden" for="RizoSearchInput">Search the store</label>
        <input class="input" id="RizoSearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Hoodie, gold, 412…" autocomplete="off" data-overlay-focus data-predictive-input aria-autocomplete="list" aria-controls="RizoPredictiveResults" aria-expanded="false">
        <input type="hidden" name="type" value="product,page,collection,article">
        <button class="btn btn--solid" type="submit">Search</button>
      </form>
      <p class="predictive-status" data-predictive-status aria-live="polite"></p>
      <div class="predictive-results" id="RizoPredictiveResults" data-predictive-results role="listbox" hidden></div>
      <div class="search-shortcuts" data-search-shortcuts><a href="{{ routes.all_products_collection_url }}">Everything {% render 'icon', name: 'arrow' %}</a><a href="{{ routes.collections_url }}">Collections {% render 'icon', name: 'arrow' %}</a></div>
    </div>
  </section>
</div>
