{%- liquid
  assign card_product = product
  assign quick_add = show_quick_add | default: false
  assign secondary_image = card_product.images[1]
  assign color_count = 0
  assign size_option = blank
  assign size_index = -1
  for option in card_product.options_with_values
    assign downcase_name = option.name | downcase
    if downcase_name contains 'color' or downcase_name contains 'colour'
      assign color_count = option.values.size
    endif
    if downcase_name contains 'size'
      assign size_option = option
      assign size_index = option.position | minus: 1
    endif
  endfor
  assign card_sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
-%}
<article class="card" data-product-card data-product-id="{{ card_product.id }}" data-product-title="{{ card_product.title | escape }}" data-product-url="{{ card_product.url }}">
  <a class="card-media" href="{{ card_product.url }}" tabindex="-1" aria-hidden="true" data-analytics="product_clicked">
    {%- if card_product.featured_image -%}
      {{ card_product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '320,480,640,800,1000,1200', sizes: card_sizes, alt: '', class: 'card-img' }}
      {%- if secondary_image -%}
        {{ secondary_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '320,480,640,800,1000,1200', sizes: card_sizes, alt: '', class: 'card-img card-img--alt' }}
      {%- endif -%}
    {%- else -%}
      <span class="placeholder-media">{% render 'rizo-mark' %}</span>
    {%- endif -%}
    <span class="card-badges">{% render 'product-badge', product: card_product %}</span>
  </a>
  <div class="card-info">
    <h3 class="card-title"><a href="{{ card_product.url }}" data-analytics="product_clicked">{{ card_product.title }}</a></h3>
    <span class="card-price">{% if card_product.price_varies %}From {% endif %}{{ card_product.price | money }}{% if card_product.compare_at_price_max > card_product.price %}<s>{{ card_product.compare_at_price_max | money }}</s>{% endif %}</span>
    {%- if color_count > 1 or show_vendor and card_product.vendor != blank -%}
      <span class="card-meta">
        {%- if color_count > 1 %}{{ color_count }} colors{% endif -%}
        {%- if show_vendor and card_product.vendor != blank %}{% if color_count > 1 %} · {% endif %}{{ card_product.vendor }}{% endif -%}
      </span>
    {%- endif -%}
  </div>
  {%- if show_size_preview and size_option != blank and card_product.available -%}
    <div class="card-sizes" aria-label="Sizes in stock">
      {%- for value in size_option.values limit: 8 -%}
        {%- assign value_available = false -%}
        {%- for variant in card_product.variants -%}
          {%- if variant.available and variant.options[size_index] == value -%}{%- assign value_available = true -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        {%- if value_available -%}<b>{{ value }}</b>{%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if quick_add and card_product.available -%}
    {%- if card_product.has_only_default_variant -%}
      {%- form 'product', card_product, class: 'card-form', data-ajax-product-form: '' -%}
        <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button class="card-add" type="submit"><span data-product-submit-label>Add to cart</span>{% render 'icon', name: 'plus' %}</button>
        <p class="form-message form-message--error" data-variant-error role="alert" hidden></p>
      {%- endform -%}
    {%- else -%}
      <button class="card-add" type="button" data-quick-add-open="{{ card_product.handle }}" data-product-url="{{ card_product.url }}.js" aria-label="{% if size_option != blank %}Choose a size{% else %}Choose options{% endif %} for {{ card_product.title | escape }}">
        {%- if size_option != blank %}Choose size{% else %}Choose options{% endif %}{% render 'icon', name: 'plus' -%}
      </button>
    {%- endif -%}
  {%- elsif card_product.available == false -%}
    <span class="card-add card-add--off">Sold out</span>
  {%- endif -%}
</article>
