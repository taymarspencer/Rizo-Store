{%- comment -%}
  RIZO EVENT LAYER — stage layers. Rendered twice from layout/theme.liquid:

    layer: 'back'   inside the fixed sky, behind every section:
                    moon, far fog, bats that fly behind the page
    layer: 'front'  fixed above the sections, below header and drawers:
                    near fog, bats that cross in front of the page

  Everything is decorative: aria-hidden, pointer-events: none, never
  focusable. Hidden by CSS until html.rizo-event. Renders nothing when the
  Event layer is Off.
{%- endcomment -%}
{%- if settings.event_layer != blank and settings.event_layer != 'off' -%}
  {%- capture ev_moon -%}{% render 'rizo-event-value', key: 'feature', feature: 'moon' %}{%- endcapture -%}
  {%- capture ev_fog -%}{% render 'rizo-event-value', key: 'feature', feature: 'fog' %}{%- endcapture -%}
  {%- capture ev_flock -%}{% render 'rizo-event-value', key: 'feature', feature: 'flock' %}{%- endcapture -%}
  {%- if layer == 'back' -%}
    <div class="rizo-event-stage rizo-event-stage--back" data-rizo-event-stage="back" aria-hidden="true">
      {%- if ev_moon == 'true' -%}
        {%- capture ev_moon_src -%}{% render 'rizo-event-value', key: 'moon_src' %}{%- endcapture -%}
        {%- assign ev_moon_src = ev_moon_src | strip -%}
        {%- if ev_moon_src != blank -%}
          <div class="rizo-event-moon" data-rizo-event-moon{% unless settings.event_moon_motion %} data-static{% endunless %} data-phase="{{ settings.event_moon_phase | default: 'real' }}">
            <span class="rizo-event-moon-halo"></span>
            <div class="rizo-event-moon-body">
              <img class="rizo-event-moon-art" src="{{ ev_moon_src }}" width="1000" height="1000" alt="" loading="eager" decoding="async" fetchpriority="low" draggable="false">
              <img class="rizo-event-moon-art rizo-event-moon-art--low" src="{{ ev_moon_src }}" width="1000" height="1000" alt="" loading="lazy" decoding="async" draggable="false">
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}
      {%- if ev_fog == 'true' -%}<div class="rizo-event-fog rizo-event-fog--back" data-rizo-event-fog="back"></div>{%- endif -%}
      {%- if ev_flock == 'true' -%}<div class="rizo-event-flock rizo-event-flock--back" data-rizo-event-flock="back"></div>{%- endif -%}
    </div>
  {%- else -%}
    <div class="rizo-event-stage rizo-event-stage--front" data-rizo-event-stage="front" aria-hidden="true">
      {%- if ev_fog == 'true' -%}<div class="rizo-event-fog rizo-event-fog--front" data-rizo-event-fog="front"></div>{%- endif -%}
      {%- if ev_flock == 'true' -%}<div class="rizo-event-flock rizo-event-flock--front" data-rizo-event-flock="front"></div>{%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
