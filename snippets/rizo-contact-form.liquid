{%- assign contact_form_id = form_id | default: 'RizoContactForm' -%}
{%- form 'contact', id: contact_form_id, class: 'contact-form' -%}
  <input type="hidden" name="contact[tags]" value="rizo-contact, storefront-contact">
  {%- if form.posted_successfully? -%}
    <div role="status" tabindex="-1" data-form-feedback class="stack">
      <h2 class="t-3">Sent.</h2>
      <p class="muted">It went to the Rizo inbox. We answer from there.</p>
    </div>
  {%- else -%}
    {%- if form.errors -%}
      <div id="{{ contact_form_id }}-errors" class="form-message form-message--error" role="alert" tabindex="-1" data-form-feedback>{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="two">
      <label class="field"><span>Name</span><input type="text" name="contact[name]" value="{% if form.name %}{{ form.name | escape }}{% endif %}" autocomplete="name" required></label>
      <label class="field"><span>Email</span><input type="email" name="contact[email]" value="{% if form.email %}{{ form.email | escape }}{% endif %}" autocomplete="email" autocapitalize="off" spellcheck="false" required{% if form.errors %} aria-invalid="true" aria-describedby="{{ contact_form_id }}-errors"{% endif %}></label>
    </div>
    <div class="two">
      <label class="field"><span>Order number (if it’s about an order)</span><input type="text" name="contact[order_number]" value="{% if form.order_number %}{{ form.order_number | escape }}{% endif %}" autocomplete="off" placeholder="#1001"></label>
      <label class="field"><span>About</span>
        <select class="select" name="contact[topic]">
          <option>An order</option><option>Sizing</option><option>Working together</option><option>Something else</option>
        </select>
      </label>
    </div>
    <label class="field"><span>Message</span><textarea name="contact[body]" rows="6" required>{% if form.body %}{{ form.body | escape }}{% endif %}</textarea></label>
    <div><button class="btn btn--solid" type="submit">Send</button></div>
  {%- endif -%}
{%- endform -%}
