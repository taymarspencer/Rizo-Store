<div class="overlay-shell" id="RizoQuickAdd" data-overlay="quick-add" hidden>
  <button class="overlay-backdrop" type="button" data-overlay-close tabindex="-1" aria-hidden="true" aria-label="Close"></button>
  <aside class="dialog" role="dialog" tabindex="-1" data-overlay-focus aria-modal="true" aria-labelledby="QuickAddTitle">
    <header class="drawer-head"><h2 id="QuickAddTitle" data-quick-add-title>Choose</h2><button class="icon-btn" type="button" data-overlay-close aria-label="Close">{% render 'icon', name: 'close' %}</button></header>
    <div class="dialog-body">
      <div class="qa-product"><div class="qa-media" data-quick-add-media></div><div><span data-quick-add-status></span><strong data-quick-add-price></strong></div></div>
      <form data-quick-add-form data-ajax-product-form class="stack" style="--stack: 18px">
        <div class="qa-options" data-quick-add-options></div>
        <p class="qa-summary" data-quick-add-summary aria-live="polite" aria-atomic="true"></p>
        <p class="form-message form-message--error" data-quick-add-error role="alert" hidden></p>
        <button class="btn btn--solid btn--full" type="submit" disabled data-quick-add-submit>Choose a size</button>
      </form>
      <a class="qa-link" href="{{ routes.all_products_collection_url }}" data-quick-add-link>Photos, fit and details {% render 'icon', name: 'arrow' %}</a>
    </div>
  </aside>
</div>
