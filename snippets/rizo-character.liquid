{% liquid
  assign variant = variant | default: 'classic'
  case variant
    when 'ember'
      assign asset = 'rizo-ember.png'
    when 'shadow'
      assign asset = 'rizo-shadow.png'
    else
      assign asset = 'rizo-classic.png'
  endcase
  assign meaningful = false
  if message != blank or alt != blank
    assign meaningful = true
  endif
  assign image_loading = loading | default: 'lazy'
  assign tag_name = 'div'
  if interaction != blank
    assign tag_name = 'button'
  endif
%}
<{{ tag_name }}{% if tag_name == 'button' %} type="button" aria-label="{{ alt | default: 'Interact with Rizo' | escape }}"{% endif %} data-rizo-character class="rizo-character rizo-character--{{ variant }} rizo-character--{{ align | default: 'center' }}{% if interaction != blank %} is-interactive{% endif %}" style="--rizo-size:{{ size | default: 220 }}px"{% if interaction != blank %} data-rizo-interaction="{{ interaction | escape }}"{% endif %}>
  {% if custom_image != blank %}
    {{ custom_image | image_url: width: 800 | image_tag: loading: image_loading, widths: '240,400,600,800', sizes: 'var(--rizo-size)', alt: alt | default: '' }}
  {% else %}
    <img src="{{ asset | asset_url }}" width="520" height="670" loading="{{ image_loading }}" alt="{% if meaningful %}{{ alt | default: 'Rizo' | escape }}{% endif %}">
  {% endif %}
  {% if message != blank %}<span class="rizo-speech">{{ message }}</span>{% endif %}
</{{ tag_name }}>
