{%- comment -%}
  An uploaded image, or one of Rizo's own photographs/scans bundled with
  the theme. Sections expose both so a new page looks finished before
  anything is uploaded, and the owner can swap any photo in the editor.

    {% render 'rizo-image', image: section.settings.image, builtin: 'underpass', sizes: '50vw', alt: '…' %}

  Phones: pass mobile_image (and mobile_sizes) for a different crop or a
  different photo under 750px. It works over an upload or a built-in.
  Crops follow the focal point set on each image in Shopify admin
  (--focal / --focal-m, applied in assets/rizo.css §19).
{%- endcomment -%}
{%- liquid
  assign img_class = class | default: ''
  assign img_loading = loading | default: 'lazy'
  assign img_sizes = sizes | default: '100vw'
  assign img_priority = fetchpriority | default: 'auto'
  assign img_alt = alt
  if img_alt == blank and image != blank
    assign img_alt = image.alt
  elsif img_alt == blank and mobile_image != blank
    assign img_alt = mobile_image.alt
  endif
  assign focal = ''
  if image.presentation.focal_point != blank
    assign focal = '--focal: ' | append: image.presentation.focal_point | append: ';'
  endif
  if mobile_image != blank and mobile_image.presentation.focal_point != blank
    assign focal = focal | append: ' --focal-m: ' | append: mobile_image.presentation.focal_point | append: ';'
  endif
  if image == blank and builtin != blank and builtin != 'none'
    case builtin
      when 'wpsd_portrait'
        assign f = 'rizo-wpsd-2026-portrait.webp'
        assign small_f = 'rizo-wpsd-2026-portrait-640.webp'
        assign w = 1019
        assign h = 1800
      when 'wpsd_hands'
        assign f = 'rizo-wpsd-2026-hands.webp'
        assign small_f = 'rizo-wpsd-2026-hands-640.webp'
        assign w = 1152
        assign h = 1536
      when 'wpsd_table'
        assign f = 'rizo-wpsd-2026-table.webp'
        assign small_f = 'rizo-wpsd-2026-table-640.webp'
        assign w = 1082
        assign h = 1536
      when 'wpsd_making'
        assign f = 'rizo-wpsd-2026-making.webp'
        assign small_f = 'rizo-wpsd-2026-making-640.webp'
        assign w = 1152
        assign h = 1536
      when 'wpsd_yellow'
        assign f = 'rizo-wpsd-2026-yellow.webp'
        assign small_f = 'rizo-wpsd-2026-yellow-640.webp'
        assign w = 1152
        assign h = 1536
      when 'wpsd_together'
        assign f = 'rizo-wpsd-2026-together.webp'
        assign small_f = 'rizo-wpsd-2026-together-640.webp'
        assign w = 1152
        assign h = 1536
      when '412_handoff'
        assign f = 'rizo-412-handoff-2026.webp'
        assign small_f = 'rizo-412-handoff-2026-640.webp'
        assign w = 1152
        assign h = 1536
      when '412_people'
        assign f = 'rizo-412-people-2026.webp'
        assign small_f = 'rizo-412-people-2026-640.webp'
        assign w = 1152
        assign h = 1536
      when 'popup_table'
        assign f = 'rizo-pop-up-table-2026.webp'
        assign small_f = 'rizo-pop-up-table-2026-640.webp'
        assign w = 1152
        assign h = 1536
      when 'outside_777_green'
        assign f = 'rizo-outside-777-green.webp'
        assign small_f = 'rizo-outside-777-green-640.webp'
        assign w = 1152
        assign h = 1536
      when 'outside_black_tee'
        assign f = 'rizo-outside-black-tee.webp'
        assign small_f = 'rizo-outside-black-tee-640.webp'
        assign w = 1152
        assign h = 1536
      when 'founder'
        assign f = 'rizo-founder-full-fit.webp'
        assign w = 1024
        assign h = 1536
      when 'founder_mural'
        assign f = 'rizo-founder-mural.webp'
        assign w = 1152
        assign h = 1536
      when 'underpass'
        assign f = 'rizo-412-underpass.webp'
        assign w = 1152
        assign h = 1536
      when 'stadium'
        assign f = 'rizo-412-stadium.webp'
        assign w = 1152
        assign h = 1536
      when 'circle_night'
        assign f = 'rizo-circle-night.webp'
        assign w = 1152
        assign h = 1536
      when 'circle_gym'
        assign f = 'rizo-circle-gym.webp'
        assign w = 1152
        assign h = 1536
      when 'circle_pink'
        assign f = 'rizo-circle-pink.webp'
        assign w = 1200
        assign h = 1800
      when 'table'
        assign f = 'rizo-community-table.webp'
        assign w = 1152
        assign h = 1536
      when 'making'
        assign f = 'rizo-community-create.webp'
        assign w = 1536
        assign h = 1152
      when 'sketch'
        assign f = 'rizo-origin-sketch.webp'
        assign w = 1152
        assign h = 1536
      when 'camo'
        assign f = 'rizo-world-camo.webp'
        assign w = 2400
        assign h = 1200
      when 'face'
        assign f = 'rizo-face-basic.png'
        assign w = 800
        assign h = 800
      when 'face_white'
        assign f = 'rizo-face-white.png'
        assign w = 317
        assign h = 360
      when 'mark_blue'
        assign f = 'rizo-logo.png'
        assign w = 497
        assign h = 650
      when 'mark_ember'
        assign f = 'rizo-ember.png'
        assign w = 520
        assign h = 670
      when 'mark_shadow'
        assign f = 'rizo-shadow.png'
        assign w = 520
        assign h = 670
      when 'mark_412'
        assign f = 'rizo-412-mark.webp'
        assign w = 768
        assign h = 768
      when 'wallpaper'
        assign f = 'rizo-world-passport-wallpaper.webp'
        assign w = 1440
        assign h = 2560
    endcase
  endif
  assign can_enlarge = false
  if enlarge
    if image != blank or f != blank or mobile_image != blank
      assign can_enlarge = true
      if image != blank
        assign full_image = image | image_url: width: 2400
      elsif f != blank
        assign full_image = f | asset_url
      else
        assign full_image = mobile_image | image_url: width: 2400
      endif
      if mobile_image != blank
        assign full_mobile = mobile_image | image_url: width: 2400
      endif
    endif
  endif
-%}
{%- if can_enlarge -%}
  <a class="image-open" href="{{ full_image }}" data-photo-open{% if full_mobile != blank %} data-photo-mobile="{{ full_mobile }}"{% endif %} aria-label="{{ 'general.view_image' | t: description: img_alt | escape }}" aria-haspopup="dialog">
{%- endif -%}
{%- if mobile_image != blank -%}
  {%- capture mobile_srcset -%}
    {%- for w in (1..4) -%}
      {%- assign mw = w | times: 360 -%}
      {%- if mw < mobile_image.width -%}{{ mobile_image | image_url: width: mw }} {{ mw }}w,{%- endif -%}
    {%- endfor -%}
    {%- assign mw = mobile_image.width | at_most: 1800 -%}{{ mobile_image | image_url: width: mw }} {{ mw }}w
  {%- endcapture -%}
  <picture>
    <source media="(max-width: 749px)" srcset="{{ mobile_srcset | strip }}" sizes="{{ mobile_sizes | default: '100vw' }}" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}">
{%- endif -%}
{%- if image != blank -%}
  {{ image | image_url: width: 2200 | image_tag: loading: img_loading, fetchpriority: img_priority, widths: '360,540,720,960,1200,1600,2200', sizes: img_sizes, alt: img_alt, class: img_class, style: focal }}
{%- elsif builtin != blank and builtin != 'none' -%}
  {%- if f != blank -%}
    <img{% if img_class != blank %} class="{{ img_class }}"{% endif %} src="{{ f | asset_url }}"{% if small_f != blank %} srcset="{{ small_f | asset_url }} 640w, {{ f | asset_url }} {{ w }}w" sizes="{{ img_sizes }}"{% endif %} width="{{ w }}" height="{{ h }}" loading="{{ img_loading }}" decoding="async"{% if img_priority != 'auto' %} fetchpriority="{{ img_priority }}"{% endif %}{% if focal != blank %} style="{{ focal }}"{% endif %} alt="{{ img_alt | escape }}">
  {%- endif -%}
{%- elsif mobile_image != blank -%}
  {{ mobile_image | image_url: width: 1800 | image_tag: loading: img_loading, widths: '360,720,1080,1440,1800', sizes: img_sizes, alt: img_alt, class: img_class }}
{%- endif -%}
{%- if mobile_image != blank -%}</picture>{%- endif -%}

{%- if can_enlarge -%}
    <span class="image-open-corner" aria-hidden="true">{% render 'icon', name: 'expand' %}</span>
  </a>
{%- endif -%}
