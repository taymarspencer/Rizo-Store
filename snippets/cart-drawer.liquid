<div class="overlay-shell drawer-shell{% if cart.item_count == 0 %} is-empty{% endif %}" id="RizoCart" data-overlay="cart" hidden data-cart-shell data-free-shipping-threshold="{{ settings.free_shipping_threshold | times: 100 }}">
  <button class="overlay-backdrop" type="button" data-overlay-close tabindex="-1" aria-hidden="true" aria-label="Close cart"></button>
  <aside class="drawer" role="dialog" tabindex="-1" data-overlay-focus aria-modal="true" aria-labelledby="CartDrawerTitle">
    <header class="drawer-head">
      <h2 id="CartDrawerTitle">Cart <span data-cart-count-heading>{% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}</span></h2>
      <button class="icon-btn" type="button" data-overlay-close aria-label="Close cart">{% render 'icon', name: 'close' %}</button>
    </header>
    <div class="ship-bar ship-bar--drawer" data-shipping-progress hidden><span data-shipping-copy></span><b data-shipping-percent hidden>0%</b><i><b data-shipping-bar></b></i></div>
    <div class="drawer-lines" data-cart-lines aria-busy="false"><p class="drawer-loading">Loading…</p></div>
    <footer class="drawer-foot">
      <div class="drawer-total"><span>Subtotal</span><span data-cart-total>{{ cart.total_price | money }}</span></div>
      <p>Shipping and taxes are worked out at checkout.</p>
      <form action="{{ routes.cart_url }}" method="post"><button class="btn btn--solid btn--full" type="submit" name="checkout" data-analytics="checkout_clicked">Check out</button></form>
      <a class="btn btn--line btn--full" href="{{ routes.cart_url }}">View cart</a>
    </footer>
  </aside>
</div>
