{%- comment -%}
  RIZO EVENT PRESET — Halloween 2026

  A preset only describes the event. The Event Layer engine does the work.
  This snippet answers one `key` at a time and is only ever rendered by
  snippets/rizo-event-value.liquid, which applies theme-setting overrides.

  Everything Halloween-specific lives in files named event-halloween*:
    snippets/event-halloween.liquid        this file (window, copy, modules, art)
    assets/event-halloween.css             art-direction tokens
    assets/event-halloween.js              how bats fly, roost and leave the moon
    assets/event-halloween-moon.webp       the moon
    assets/event-halloween-bat-a.svg / -b  flight sheets, 4 frames each (120×84 per frame)
    assets/event-halloween-bat-roost.svg   roosting sheet, 3 frames (64×96 per frame)

  Retire it: Theme settings → Event layer → Active event → Off.
  Remove it for good: delete those files, the 'halloween' option in
  config/settings_schema.json and its `when` line in rizo-event-value.liquid.
{%- endcomment -%}
{%- case key -%}
  {%- when 'name' -%}Halloween 2026
  {%- when 'theme_class' -%}rizo-october
  {%- when 'modules' -%}night,moon,fog,flock,countdown
  {%- when 'timezone' -%}America/New_York
  {%- when 'start' -%}2026-09-23T00:00:00-04:00
  {%- when 'end' -%}2026-11-01T06:00:00-05:00
  {%- when 'announcement' -%}
  {%- when 'countdown_target' -%}2026-10-31T00:00:00-04:00
  {%- when 'countdown_label' -%}Halloween in
  {%- when 'countdown_expired_label' -%}Tonight.
  {%- when 'countdown_description' -%}Halloween begins
  {%- when 'stylesheet' -%}event-halloween.css
  {%- when 'behavior_script' -%}event-halloween.js
  {%- when 'moon_src' -%}{{ 'event-halloween-moon.webp' | asset_url }}
  {%- when 'flock_behavior' -%}bats
  {%- when 'flock_sprites' -%}
    [{"src":{{ 'event-halloween-bat-a.svg' | asset_url | json }},"frames":4,"ratio":1.4286},{"src":{{ 'event-halloween-bat-b.svg' | asset_url | json }},"frames":4,"ratio":1.4286}]
  {%- when 'flyer_sheet' -%}{{ 'event-halloween-bat-a.svg' | asset_url }}
  {%- when 'roost_sprite' -%}{{ 'event-halloween-bat-roost.svg' | asset_url }}
{%- endcase -%}
