{
  "name": "rizo-theme-tools",
  "private": true,
  "description": "Local preview harness and automated checks for the Rizo Shopify theme. Not part of the theme upload.",
  "type": "module",
  "scripts": {
    "preview": "node preview/server.mjs",
    "check": "node schema/sync-art.mjs --check && node tests/theme-check.mjs",
    "test": "node tests/event-layer.test.mjs",
    "test:design": "node tests/design.test.mjs",
    "preview:catalog": "RIZO_PREVIEW_CATALOG=snapshot node preview/server.mjs",
    "sync:art": "node schema/sync-art.mjs"
  },
  "devDependencies": {
    "@shopify/theme-check-node": "^3.29.0",
    "liquidjs": "^10.29.0",
    "playwright": "1.56.0"
  }
}
