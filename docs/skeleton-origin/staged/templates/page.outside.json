    "worn": {
      "type": "rizo-gallery",
      "settings": {
        "heading": "They make it look better.",
        "layout": "archive",
        "surface": "solid",
        "space": "m",
        "fog": 0,
        "label": "01 / Rizo, worn",
        "link_label": "",
        "link": "",
        "text": "<p>Somebody can put on something I already thought was cool and make it look better than I ever imagined.</p><p>I love when somebody treats Rizo like normal clothes and just lives in it. Or saves a piece for a vacation, or something special.</p>",
        "anchor": "worn"
