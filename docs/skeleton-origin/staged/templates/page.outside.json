    "event": {
      "type": "rizo-gallery",
      "settings": {
        "heading": "The kids had fun. We did it.",
        "layout": "archive",
        "surface": "solid",
        "space": "m",
        "fog": 0,
        "label": "02 / WPSD / Pittsburgh, PA",
        "text": "<p>The first tie-dye table was a test. We barely knew what we were doing. Years later, there is still chaos. Just better chaos.</p>",
        "anchor": "table"
      },
