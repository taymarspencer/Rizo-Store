{%- comment -%}
  Real objects, laid down on the night: scans, prints, drawings, marks.
  Each keeps the look of what it is made of (paper sits on paper, a print
  has its border, a mark is just the mark). Placement is chosen per block,
  never random. A block can carry a lens for looking closer, and one can
  show tonight's moon phase (filled in by the event layer when it's live).
{%- endcomment -%}
<section class="s" data-surface="{{ section.settings.surface }}" data-space="{{ section.settings.space }}" data-fog="{{ section.settings.fog | divided_by: 100.0 }}" data-fog-bias="ground">
  <div class="wrap wrap--wide">
    {%- if section.settings.heading != blank -%}<div class="s-head"><h2 class="s-title t-2">{{ section.settings.heading | escape }}</h2></div>{%- endif -%}
    <div class="artifacts">
      {%- for block in section.blocks -%}
        {%- assign start = 12 | minus: block.settings.span | divided_by: 2 | floor | plus: 1 -%}
        <figure class="artifact" data-material="{{ block.settings.material }}" data-place="{{ block.settings.place }}" data-offset="{{ block.settings.offset }}" style="--span: {{ block.settings.span }}; --start: {{ start }}; --tilt: {{ block.settings.tilt }}deg" {{ block.shopify_attributes }}>
          <div class="artifact-body{% if block.settings.lens %} lens-host{% endif %}"{% if block.settings.lens %} data-lens{% endif %}>
            {% render 'rizo-image', image: block.settings.image, builtin: block.settings.builtin_image, sizes: '(min-width: 750px) 50vw, 100vw', alt: block.settings.alt %}
            {%- if block.settings.lens -%}<span class="lens" aria-hidden="true"></span>{%- endif -%}
          </div>
          {%- if block.settings.title != blank or block.settings.caption != blank or block.settings.moon_phase or block.settings.download_label != blank -%}
            <figcaption>
              {%- if block.settings.title != blank -%}<strong>{{ block.settings.title | escape }}</strong>{%- endif -%}
              {%- if block.settings.caption != blank -%}<span>{{ block.settings.caption | escape }}</span>{%- endif -%}
              {%- if block.settings.moon_phase -%}<span data-rizo-moon-phase hidden></span>{%- endif -%}
              {%- if block.settings.download_label != blank -%}
                {%- assign dl = blank -%}
                {%- if block.settings.image != blank -%}{%- assign dl = block.settings.image | image_url: width: 2400 -%}{%- elsif block.settings.builtin_image == 'wallpaper' -%}{%- assign dl = 'rizo-world-passport-wallpaper.webp' | asset_url -%}{%- elsif block.settings.builtin_image == 'camo' -%}{%- assign dl = 'rizo-world-camo.webp' | asset_url -%}{%- endif -%}
                {%- if dl != blank -%}<a class="link" href="{{ dl }}" download>{% render 'icon', name: 'arrow-down' %}<span>{{ block.settings.download_label | escape }}</span></a>{%- endif -%}
              {%- endif -%}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Objects",
  "tag": "div",
  "class": "section-artifacts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "select", "id": "surface", "label": "Surface", "default": "open", "options": [{ "value": "solid", "label": "Solid" }, { "value": "raised", "label": "Raised" }, { "value": "open", "label": "Open sky" }] },
    { "type": "select", "id": "space", "label": "Space", "default": "m", "options": [{ "value": "s", "label": "Tight" }, { "value": "m", "label": "Normal" }, { "value": "l", "label": "Loose" }] },
    { "type": "range", "id": "fog", "label": "Fog", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 40 }
  ],
  "blocks": [
    {
      "type": "object",
      "name": "Object",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "builtin_image", "label": "Image when none is uploaded", "default": "sketch", "options": [
          { "value": "sketch", "label": "First drawing" }, { "value": "face_white", "label": "The face (light)" }, { "value": "face", "label": "The face (dark, for paper)" }, { "value": "mark_blue", "label": "The flame" },
          { "value": "mark_412", "label": "412" }, { "value": "camo", "label": "Camo" }, { "value": "stadium", "label": "Stadium at night" },
          { "value": "wallpaper", "label": "Camo phone wallpaper" }, { "value": "founder_mural", "label": "Taymar at the mural" }, { "value": "none", "label": "None" }
        ] },
        { "type": "text", "id": "alt", "label": "Description" },
        { "type": "select", "id": "material", "label": "What it is", "default": "photo", "options": [
          { "value": "paper", "label": "Drawing on paper" }, { "value": "print", "label": "Printed photo" }, { "value": "photo", "label": "Photo" },
          { "value": "scan", "label": "Scan" }, { "value": "object", "label": "Cut-out mark" }
        ] },
        { "type": "range", "id": "span", "label": "Width (of 12 columns)", "min": 3, "max": 12, "step": 1, "default": 6 },
        { "type": "select", "id": "place", "label": "Placement", "default": "auto", "options": [{ "value": "auto", "label": "Next in line" }, { "value": "left", "label": "Left edge" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right edge" }] },
        { "type": "select", "id": "offset", "label": "Vertical", "default": "none", "options": [{ "value": "none", "label": "In line" }, { "value": "down", "label": "Lower" }, { "value": "up", "label": "Higher" }] },
        { "type": "range", "id": "tilt", "label": "Tilt", "min": -6, "max": 6, "step": 0.5, "unit": "°", "default": 0 },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "checkbox", "id": "lens", "label": "Lens for looking closer", "default": false },
        { "type": "text", "id": "download_label", "label": "Download link label", "info": "Lets people save the image (for example the camo phone wallpaper). Blank hides it." },
        { "type": "checkbox", "id": "moon_phase", "label": "Show tonight's moon phase", "default": false, "info": "Filled in while an event with a moon is live." }
      ]
    }
  ],
  "presets": [{ "name": "Objects", "blocks": [{ "type": "object", "settings": { "material": "paper", "tilt": -2 } }] }]
}
{% endschema %}
