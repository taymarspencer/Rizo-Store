<section class="legacy-ledger page-width" data-legacy-ledger>
  <header class="legacy-ledger-intro">
    {% render 'rizo-dateline', label: section.settings.dateline_label %}
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<div class="rte legacy-ledger-copy">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.link_label != blank %}<a class="text-arrow" href="{{ section.settings.link | default: routes.all_products_collection_url }}" data-analytics="legacy_entry_clicked">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}
  </header>

  <div class="legacy-ledger-track" role="list" aria-label="{{ section.settings.heading | escape }}">
    {% for block in section.blocks %}
      {% liquid
        assign entry_product = block.settings.product
        assign entry_link = block.settings.link
        assign entry_image = block.settings.image
        if entry_product != blank
          assign entry_link = entry_product.url
          if entry_image == blank
            assign entry_image = entry_product.featured_image
          endif
        endif
      %}
      <article class="legacy-entry legacy-entry--{{ block.settings.tone }}" role="listitem" {{ block.shopify_attributes }}>
        <a href="{{ entry_link | default: routes.all_products_collection_url }}" data-analytics="legacy_entry_clicked">
          <div class="legacy-entry-meta">
            <span>{{ forloop.index | prepend: '0' }}</span>
            <time>{{ block.settings.date }}</time>
            <time>{{ block.settings.time }}</time>
          </div>
          <div class="legacy-entry-media">
            {% if entry_image != blank %}
              {{ entry_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '320,480,720,960,1200', sizes: '(min-width: 900px) 28vw, 78vw', alt: entry_image.alt | default: block.settings.title }}
            {% else %}
              <div class="legacy-entry-placeholder" aria-hidden="true"><span>××××</span><b>RIZO</b></div>
            {% endif %}
            {% if block.settings.character != 'none' %}{% render 'rizo-character', variant: block.settings.character, size: 120, loading: 'lazy', alt: '' %}{% endif %}
          </div>
          <div class="legacy-entry-copy">
            <small>{{ block.settings.label }}</small>
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
            <div><span>{{ block.settings.link_label }}</span>{% if entry_product != blank %}<b>{{ entry_product.price | money }}</b>{% endif %}{% render 'icon', name: 'arrow' %}</div>
          </div>
        </a>
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name":"Original signal ledger",
  "tag":"section",
  "class":"section-legacy-ledger",
  "max_blocks":6,
  "settings":[
    {"type":"text","id":"dateline_label","label":"Dateline label","default":"ORIGINAL SIGNAL / PITTSBURGH"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE SITE REMEMBERS"},
    {"type":"text","id":"heading","label":"Heading","default":"A DATE. A TIME. A FEW PIECES. A WAY IN."},
    {"type":"richtext","id":"text","label":"Text","default":"<p>The first Rizo store was stripped down and strange in the right way. This ledger keeps that original honesty while every entry leads somewhere real.</p>"},
    {"type":"text","id":"link_label","label":"Main link label","default":"SHOP THE CURRENT SIGNAL"},
    {"type":"url","id":"link","label":"Main link"}
  ],
  "blocks":[
    {
      "type":"entry",
      "name":"Ledger entry",
      "settings":[
        {"type":"text","id":"date","label":"Date","default":"02/22/2023"},
        {"type":"text","id":"time","label":"Time","default":"2:22 PM"},
        {"type":"text","id":"label","label":"Label","default":"ORIGINAL SIGNAL"},
        {"type":"text","id":"title","label":"Title","default":"WHERE THE PORTAL OPENED"},
        {"type":"textarea","id":"text","label":"Text","default":"The archive is not nostalgia. It is proof the world started somewhere real."},
        {"type":"product","id":"product","label":"Optional product"},
        {"type":"image_picker","id":"image","label":"Optional image override"},
        {"type":"url","id":"link","label":"Link"},
        {"type":"text","id":"link_label","label":"Link label","default":"OPEN ENTRY"},
        {"type":"select","id":"character","label":"Rizo character","default":"none","options":[{"value":"none","label":"None"},{"value":"classic","label":"Classic"},{"value":"ember","label":"Ember"},{"value":"shadow","label":"Shadow"}]},
        {"type":"select","id":"tone","label":"Tone","default":"paper","options":[{"value":"paper","label":"Paper"},{"value":"blue","label":"Blue"},{"value":"heat","label":"Heat"},{"value":"night","label":"Night"}]}
      ]
    }
  ],
  "presets":[{"name":"Original signal ledger","blocks":[{"type":"entry"},{"type":"entry"},{"type":"entry"}]}]
}
{% endschema %}
