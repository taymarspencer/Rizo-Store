{%- comment -%}
  Products from one collection. Solid ground and no fog: this is where
  people shop, so the atmosphere steps back.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign limit = section.settings.products_to_show
  assign product_list = source.products
  assign count = source.products_count
  if section.settings.use_selected_products
    assign product_list = section.settings.selected_products
    assign count = product_list.size
  endif
  assign ops = shop.metafields.rizo_ops
  if request.page_type == 'index' and ops.theme_enabled.value == true
    assign ops_collection = ops.home_collection.value
    if ops_collection.handle != blank
      assign published_collection = collections[ops_collection.handle]
      if published_collection.id == ops_collection.id and published_collection.url != blank
        assign product_list = published_collection.products
        assign count = published_collection.products_count
      endif
    endif
    assign ops_product = ops.featured_product.value
    if ops_product.handle != blank
      assign published_product = all_products[ops_product.handle]
      if published_product.id == ops_product.id and published_product.url != blank and published_product.published_at != blank
        assign featured_product = published_product
      endif
    endif
  endif
  assign shown = product_list.size | at_most: limit
  if featured_product != blank
    for product in product_list limit: limit
      if product.id == featured_product.id
        assign shown = shown | minus: 1
        break
      endif
    endfor
  endif
-%}
<section class="s products" data-surface="{{ section.settings.surface }}" data-space="{{ section.settings.space }}" data-fog="0" data-rizo-event-quiet id="Shop-{{ section.settings.anchor | default: section.id | handle }}">
  {% render 'rizo-art', section: section %}
  <div class="wrap wrap--wide">
    <div class="s-head">
      <div>
        {%- if section.settings.label != blank -%}<p class="v-label">{{ section.settings.label | escape }}{% if section.settings.show_count and count > 0 %} · {{ count }} {% if count == 1 %}piece{% else %}pieces{% endif %}{% endif %}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="s-title t-2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link" href="{{ source.url | default: routes.all_products_collection_url }}"><span>{{ section.settings.link_label | escape }}</span>{% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>

    {%- if featured_product != blank -%}
      <div class="ops-featured-product" role="region" aria-label="Featured product">
        {% render 'product-card', product: featured_product, show_quick_add: section.settings.show_quick_add, show_size_preview: section.settings.show_sizes, sizes: '(min-width: 520px) 448px, 100vw' %}
      </div>
    {%- endif -%}

    {%- if shown > 0 -%}
      <div class="{% if section.settings.layout == 'shelf' %}shelf-track{% else %}grid-products{% endif %}" data-count="{{ shown }}">
        {%- for product in product_list limit: limit -%}
          {%- if featured_product != blank and product.id == featured_product.id -%}
            {%- continue -%}
          {%- endif -%}
          {% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add, show_size_preview: section.settings.show_sizes %}
        {%- endfor -%}
      </div>
    {%- elsif product_list.size == 0 -%}
      <p class="muted">Nothing here right now. New pieces show up here first.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Products",
  "tag": "div",
  "class": "section-products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show everything."
    },
    {
      "type": "checkbox",
      "id": "use_selected_products",
      "label": "Use only hand-picked pieces",
      "default": false,
      "info": "When enabled, an empty selection stays empty instead of showing the full catalog."
    },
    {
      "type": "product_list",
      "id": "selected_products",
      "label": "Hand-picked pieces",
      "limit": 16,
      "info": "Used when ‘Use only hand-picked pieces’ is enabled. Keep selections here so you can switch between this edit and a collection without rebuilding it."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "shelf",
          "label": "Shelf (scrolls sideways)"
        }
      ]
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "Shop"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show how many pieces",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link",
      "default": "All pieces"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Quick add",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sizes",
      "label": "Sizes in stock",
      "default": false
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Surface",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "raised",
          "label": "Raised"
        },
        {
          "value": "open",
          "label": "Open sky"
        }
      ]
    },
    {
      "type": "select",
      "id": "space",
      "label": "Space",
      "default": "m",
      "options": [
        {
          "value": "s",
          "label": "Tight"
        },
        {
          "value": "m",
          "label": "Normal"
        },
        {
          "value": "l",
          "label": "Loose"
        }
      ]
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Section anchor",
      "info": "Optional stable target for links, such as pieces for #Shop-pieces."
    }
  ],
  "blocks": [
    {
      "type": "art",
      "name": "Art",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Artwork", "info": "Transparent PNG or WebP works best. Later blocks sit on top of earlier ones." },
        { "type": "image_picker", "id": "image_mobile", "label": "Phone version", "info": "Optional: a different crop, or a different piece, for phones." },
        { "type": "select", "id": "builtin_art", "label": "Included artwork", "default": "none", "info": "Used when Artwork is empty. Uploads take priority. Included art needs no Files upload.", "options": [
          { "value": "none", "label": "None" },
          { "value": "event-rizo-pumpkin-ember", "label": "Ember pumpkin" },
          { "value": "event-rizo-pumpkin-coal", "label": "Coal pumpkin" },
          { "value": "event-rizo-apparition", "label": "Linen apparition" },
          { "value": "rizo-face-scrawl", "label": "Face scrawl" }
        ] },
        { "type": "header", "content": "Placement" },
        { "type": "range", "id": "x", "label": "Across", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 80, "info": "Where the centre of the piece sits, as a share of the section." },
        { "type": "range", "id": "y", "label": "Down", "min": -20, "max": 120, "step": 2, "unit": "%", "default": 30, "info": "Below 0 or above 100 hangs over the edge of the section." },
        { "type": "range", "id": "size", "label": "Size", "min": 4, "max": 140, "step": 2, "unit": "%", "default": 22, "info": "Width, as a share of the section's width." },
        { "type": "range", "id": "rotate", "label": "Turn", "min": -180, "max": 180, "step": 5, "unit": "°", "default": 0 },
        { "type": "range", "id": "opacity", "label": "Opacity", "min": 5, "max": 100, "step": 5, "unit": "%", "default": 100 },
        { "type": "select", "id": "layer", "label": "Layer", "default": "back", "options": [
          { "value": "back", "label": "Behind the content" },
          { "value": "front", "label": "In front of the content" },
          { "value": "back-front", "label": "Behind on desktop, in front on phones" },
          { "value": "front-back", "label": "In front on desktop, behind on phones" }
        ] },
        { "type": "select", "id": "blend", "label": "Blend", "default": "normal", "options": [
          { "value": "normal", "label": "Normal" },
          { "value": "screen", "label": "Screen (only lightens)" },
          { "value": "multiply", "label": "Multiply (only darkens)" },
          { "value": "overlay", "label": "Overlay" },
          { "value": "soft-light", "label": "Soft light" },
          { "value": "difference", "label": "Difference" },
          { "value": "luminosity", "label": "Luminosity" }
        ] },
        { "type": "header", "content": "Phones" },
        { "type": "select", "id": "show", "label": "Show on", "default": "all", "options": [
          { "value": "all", "label": "Desktop and phones" },
          { "value": "desktop", "label": "Desktop only" },
          { "value": "phone", "label": "Phones only" }
        ] },
        { "type": "range", "id": "mobile_x", "label": "Across on phones", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 80 },
        { "type": "range", "id": "mobile_y", "label": "Down on phones", "min": -20, "max": 120, "step": 2, "unit": "%", "default": 20 },
        { "type": "range", "id": "mobile_size", "label": "Size on phones", "min": 4, "max": 140, "step": 2, "unit": "%", "default": 40 },
        { "type": "header", "content": "Movement" },
        { "type": "select", "id": "motion", "label": "Movement", "default": "none", "options": [
          { "value": "none", "label": "Still" },
          { "value": "float", "label": "Floats" },
          { "value": "sway", "label": "Sways from its top edge" },
          { "value": "depth", "label": "Depth: drifts as the page scrolls" },
          { "value": "settle", "label": "Settles into place when it appears" },
          { "value": "shy", "label": "Moves away from the pointer or finger" },
          { "value": "wobble", "label": "Wobbles when touched" },
          { "value": "spin", "label": "Spins when touched" }
        ] },
        { "type": "range", "id": "strength", "label": "How much", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "type": "select", "id": "when", "label": "When", "default": "always", "options": [
          { "value": "always", "label": "Always" },
          { "value": "event", "label": "Only while a seasonal event is on" },
          { "value": "normal", "label": "Only when no event is on" }
        ] },
        { "type": "text", "id": "name", "label": "Name for custom CSS", "info": "Optional. Adds data-art=\"name\" to the piece." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products"
    }
  ]
}
{% endschema %}
