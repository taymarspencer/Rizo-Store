{% liquid
  assign image_count = 0
  for block in section.blocks
    assign archive_asset = block.settings.archive_asset | default: 'none'
    if block.settings.image != blank or archive_asset != 'none'
      assign image_count = image_count | plus: 1
    endif
  endfor
%}

{% if image_count > 0 %}
  <section class="world-gallery world-gallery--archive page-width" id="RizoWorldArchive">
    <header class="section-heading world-gallery-heading">
      <div>
        {% if section.settings.show_dateline %}{% render 'rizo-dateline', label: section.settings.dateline_label %}{% endif %}
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.text != blank %}<p class="section-intro">{{ section.settings.text }}</p>{% endif %}
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="text-link world-gallery-link" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}
      </div>
      <img class="world-gallery-seal" src="{{ 'rizo-face-basic.png' | asset_url }}" width="800" height="800" loading="lazy" alt="" aria-hidden="true">
    </header>

    <div class="documentary-grid documentary-grid--rizo">
      {% for block in section.blocks %}
        {% liquid
          assign fallback_asset = blank
          assign fallback_width = 1152
          assign fallback_height = 1536
          assign archive_asset = block.settings.archive_asset | default: 'none'
          case archive_asset
            when 'founder_mural'
              assign fallback_asset = 'rizo-founder-mural.webp'
            when 'founder_full_fit'
              assign fallback_asset = 'rizo-founder-full-fit.webp'
              assign fallback_width = 1024
            when 'community_create'
              assign fallback_asset = 'rizo-community-create.webp'
              assign fallback_width = 1536
              assign fallback_height = 1152
            when 'community_table'
              assign fallback_asset = 'rizo-community-table.webp'
            when 'stadium'
              assign fallback_asset = 'rizo-412-stadium.webp'
            when 'underpass'
              assign fallback_asset = 'rizo-412-underpass.webp'
            when 'circle_night'
              assign fallback_asset = 'rizo-circle-night.webp'
            when 'circle_gym'
              assign fallback_asset = 'rizo-circle-gym.webp'
            when 'circle_pink'
              assign fallback_asset = 'rizo-circle-pink.webp'
              assign fallback_width = 1200
              assign fallback_height = 1800
          endcase
        %}

        {% if block.settings.image != blank or fallback_asset != blank %}
          <figure class="documentary-card" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}<a href="{{ block.settings.link }}"{% if block.settings.external %} target="_blank" rel="noopener"{% endif %}>{% endif %}
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '320,500,760,1000', sizes: '(min-width:900px) 25vw,50vw', alt: block.settings.alt | default: block.settings.caption }}
              {% else %}
                <img src="{{ fallback_asset | asset_url }}" width="{{ fallback_width }}" height="{{ fallback_height }}" loading="lazy" alt="{{ block.settings.alt | default: block.settings.caption | escape }}">
              {% endif %}
              {% if block.settings.link != blank and block.settings.external %}<span class="visually-hidden"> (opens in a new tab)</span>{% endif %}
            {% if block.settings.link != blank %}</a>{% endif %}
            <figcaption>
              {% if block.settings.location != blank %}<span>{{ block.settings.location }}</span>{% endif %}
              {{ block.settings.caption }}
              {% if block.settings.product != blank %}<a href="{{ block.settings.product.url }}">Wearing {{ block.settings.product.title }}</a>{% endif %}
            </figcaption>
          </figure>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% elsif request.design_mode %}
  <div class="editor-setup-state page-width">Add real customer, event, campaign, or built-in Rizo archive images before publishing “Seen in the world.”</div>
{% endif %}

{% schema %}
{
  "name":"Seen in the world",
  "class":"section-world-gallery",
  "max_blocks":12,
  "settings":[
    {"type":"checkbox","id":"show_dateline","label":"Show world fileline","default":false},
    {"type":"text","id":"dateline_label","label":"Fileline label","default":"WORLD FILE / PITTSBURGH OUTSIDE"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"SEEN OUTSIDE"},
    {"type":"text","id":"heading","label":"Heading","default":"THE WORLD LEAVES THE SCREEN."},
    {"type":"textarea","id":"text","label":"Text","default":"Pittsburgh concrete. Real people. Rizo outside."},
    {"type":"text","id":"button_label","label":"Optional link label","default":"READ THE ORIGIN"},
    {"type":"url","id":"button_link","label":"Optional link"}
  ],
  "blocks":[
    {
      "type":"image",
      "name":"World image",
      "settings":[
        {"type":"image_picker","id":"image","label":"Optional replacement image"},
        {"type":"select","id":"archive_asset","label":"Built-in Rizo archive image","default":"none","options":[{"value":"none","label":"None"},{"value":"founder_mural","label":"Founder at Pittsburgh mural"},{"value":"founder_full_fit","label":"Founder in full Rizo fit"},{"value":"community_create","label":"Community creative table interaction"},{"value":"community_table","label":"Community art table"},{"value":"stadium","label":"412 outside the stadium"},{"value":"underpass","label":"412 underpass campaign"},{"value":"circle_night","label":"Rizo circle at night"},{"value":"circle_gym","label":"Rizo circle gym mirror"},{"value":"circle_pink","label":"Pink Rizo hoodie portrait"}]},
        {"type":"text","id":"alt","label":"Alt text"},
        {"type":"text","id":"caption","label":"Caption"},
        {"type":"text","id":"location","label":"Location"},
        {"type":"product","id":"product","label":"Linked product"},
        {"type":"url","id":"link","label":"Optional external link"},
        {"type":"checkbox","id":"external","label":"Open link in new tab","default":true}
      ]
    }
  ],
  "presets":[{"name":"Seen in the world","blocks":[{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"}]}]
}
{% endschema %}
