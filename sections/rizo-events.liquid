<section class="events page-width">{% if settings.heritage_mode %}{% render 'rizo-dateline', label: 'OUTSIDE / PITTSBURGH / EVENT FILE' %}{% endif %}<header class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="section-intro">{{ section.settings.text }}</p></div></header><div class="event-grid">{% for block in section.blocks %}<article class="event-card{% if block.settings.past %} is-past{% endif %}" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,700,1000,1200', sizes: '(min-width:900px) 40vw,100vw', alt: block.settings.name }}{% endif %}<div><span class="release-pill"><span></span>{% if block.settings.past %}PAST EVENT{% else %}OUTSIDE SOON{% endif %}</span><h3>{{ block.settings.name }}</h3><p><strong>{{ block.settings.date }}</strong> · {{ block.settings.time }}</p><p>{{ block.settings.venue }}<br>{{ block.settings.address }}</p><div class="rte">{{ block.settings.description }}</div><div class="event-actions">{% if block.settings.map_link != blank %}<a class="button button-ghost" href="{{ block.settings.map_link }}" target="_blank" rel="noopener" data-analytics="event_link_clicked">MAP<span class="visually-hidden"> (opens in a new tab)</span></a>{% endif %}{% if block.settings.calendar_link != blank %}<a class="text-link" href="{{ block.settings.calendar_link }}">ADD TO CALENDAR</a>{% endif %}</div></div></article>{% endfor %}</div></section>
{% schema %}{"name":"Outside events","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FIND US OUTSIDE"},{"type":"text","id":"heading","label":"Heading","default":"THE WORLD EXISTS OFFLINE TOO."},{"type":"textarea","id":"text","label":"Text","default":"Vending tables, pop-ups, collaborations, and places to meet the people behind the clothes."}],"blocks":[{"type":"event","name":"Event","settings":[{"type":"text","id":"name","label":"Event name"},{"type":"text","id":"date","label":"Date"},{"type":"text","id":"time","label":"Time"},{"type":"text","id":"venue","label":"Venue"},{"type":"textarea","id":"address","label":"Address"},{"type":"url","id":"map_link","label":"Map link"},{"type":"url","id":"calendar_link","label":"Add to calendar link"},{"type":"image_picker","id":"image","label":"Event image"},{"type":"richtext","id":"description","label":"Description"},{"type":"checkbox","id":"past","label":"Past event","default":false}]}],"presets":[{"name":"Outside events","blocks":[{"type":"event"}]}]}{% endschema %}
