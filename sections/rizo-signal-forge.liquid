<section class="signal-forge page-width" id="RizoSignalForge" data-signal-forge>
  <div class="signal-forge-art" aria-hidden="true">
    <img src="{{ 'rizo-world-camo.webp' | asset_url }}" width="2400" height="1200" loading="lazy" alt="">
    <img src="{{ 'rizo-logo-white.webp' | asset_url }}" width="1393" height="1600" loading="lazy" alt="">
  </div>

  <header class="signal-forge-heading">
    <div>
      {% if section.settings.show_dateline %}{% render 'rizo-dateline', label: section.settings.dateline_label %}{% endif %}
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>
  </header>

  <div class="signal-forge-interface">
    <div class="signal-forge-choices">
      <fieldset>
        <legend>01 / WHAT ARE YOU CARRYING?</legend>
        <div class="signal-forge-options">
          <button type="button" class="is-active" data-forge-intent="pressure" data-forge-line="TURN PRESSURE INTO FORM" data-forge-art="{{ 'rizo-logo-white.webp' | asset_url }}">PRESSURE</button>
          <button type="button" data-forge-intent="idea" data-forge-line="GIVE THE IDEA A BODY" data-forge-art="{{ 'rizo-logo-white.webp' | asset_url }}">AN IDEA</button>
          <button type="button" data-forge-intent="city" data-forge-line="CARRY THE CITY PAST ITS LIMITS" data-forge-art="{{ 'rizo-412-mark.webp' | asset_url }}">THE CITY</button>
          <button type="button" data-forge-intent="future" data-forge-line="BUILD WHAT DOES NOT EXIST YET" data-forge-art="{{ 'rizo-secondary-face.png' | asset_url }}">THE FUTURE</button>
        </div>
      </fieldset>

      <fieldset>
        <legend>02 / HOW SHOULD IT MOVE?</legend>
        <div class="signal-forge-options">
          <button type="button" class="is-active" data-forge-energy="quiet" data-forge-line="MOVE QUIET. LET THE WORK SPEAK.">QUIET</button>
          <button type="button" data-forge-energy="loud" data-forge-line="MAKE THE SIGNAL IMPOSSIBLE TO IGNORE.">LOUD</button>
          <button type="button" data-forge-energy="raw" data-forge-line="LEAVE THE PROCESS VISIBLE.">RAW</button>
          <button type="button" data-forge-energy="unfinished" data-forge-line="START BEFORE YOU FEEL READY.">UNFINISHED</button>
        </div>
      </fieldset>
    </div>

    <article class="signal-forge-output" data-forge-output aria-live="polite">
      <span data-forge-code>RZ-PQ-412</span>
      <img src="{{ 'rizo-logo-white.webp' | asset_url }}" width="1393" height="1600" loading="lazy" alt="" aria-hidden="true">
      <p data-forge-primary>TURN PRESSURE INTO FORM</p>
      <strong data-forge-secondary>MOVE QUIET. LET THE WORK SPEAK.</strong>
      <small>RIZO WORLD / PITTSBURGH</small>
    </article>
  </div>

  <div class="signal-forge-actions">
    <a class="button button-hot" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">{{ section.settings.shop_label }} {% render 'icon', name: 'arrow' %}</a>
    <button class="button button-ghost" type="button" data-forge-share>{{ section.settings.share_label }}</button>
    <button class="text-link signal-forge-copy" type="button" data-forge-copy>{{ section.settings.copy_label }}</button>
  </div>
  <p class="signal-forge-note">Generated in your browser. Sharing only happens when you choose it.</p>
</section>

{% schema %}
{
  "name":"Rizo signal forge",
  "tag":"section",
  "class":"section-signal-forge",
  "settings":[
    {"type":"checkbox","id":"show_dateline","label":"Show forge fileline","default":true},
    {"type":"text","id":"dateline_label","label":"Fileline label","default":"SIGNAL FORGE / LOCAL GENERATOR"},
    {"type":"text","id":"eyebrow","label":"Optional eyebrow"},
    {"type":"text","id":"heading","label":"Heading","default":"FORGE A SIGNAL. CARRY IT OUT."},
    {"type":"textarea","id":"text","label":"Intro text","default":"Choose what you carry. Choose how it moves. Rizo turns both into a signal."},
    {"type":"text","id":"shop_label","label":"Shop button label","default":"WEAR THE SIGNAL"},
    {"type":"url","id":"shop_link","label":"Shop button link"},
    {"type":"text","id":"share_label","label":"Share button label","default":"SHARE THE SIGNAL"},
    {"type":"text","id":"copy_label","label":"Copy button label","default":"COPY SIGNAL"}
  ],
  "presets":[{"name":"Rizo signal forge"}]
}
{% endschema %}
