{% assign mode = section.settings.mode %}
<section class="next-signal page-width" data-release-module data-mode="{{ mode }}" data-date="{{ section.settings.release_date | escape }}" data-expired-heading="{{ section.settings.live_heading | escape }}" data-expired-copy="{{ section.settings.live_copy | escape }}">
  <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 data-release-heading>{{ section.settings.heading }}</h2><p data-release-copy>{{ section.settings.copy }}</p>{% if mode == 'countdown' %}<div class="signal-countdown" role="timer" aria-label="Countdown to the next Rizo signal" data-countdown><span><b data-days>00</b>DAYS</span><span><b data-hours>00</b>HRS</span><span><b data-minutes>00</b>MIN</span><span><b data-seconds>00</b>SEC</span></div>{% elsif mode == 'event' %}<div class="event-callout"><strong>{{ section.settings.event_date }}</strong><span>{{ section.settings.event_location }}</span></div>{% endif %}</div>
  <div class="signal-action">{% if section.settings.show_signup %}{% form 'customer', class: 'newsletter-form' %}{% assign next_signal_error_id = 'NextSignalError-' | append: section.id %}<input type="hidden" name="contact[tags]" value="newsletter, rizo-signal"><label for="SignalEmail-{{ section.id }}">{{ section.settings.signup_value }}</label><div class="newsletter-field"><input id="SignalEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="EMAIL ADDRESS"{% if form.errors %} aria-invalid="true" aria-describedby="{{ next_signal_error_id }}"{% endif %}><button class="button button-hot" type="submit" data-analytics="drop_reminder_submitted">GET THE SIGNAL</button></div>{% if form.posted_successfully? %}<p class="form-message" role="status" tabindex="-1" data-form-feedback>Signal received.</p>{% endif %}{% if form.errors %}<div id="{{ next_signal_error_id }}" class="form-message form-message--error" role="alert" tabindex="-1" data-form-feedback>{{ form.errors | default_errors }}</div>{% endif %}{% endform %}{% elsif section.settings.button_label != blank %}<a class="button button-hot" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div>
</section>
{% schema %}{"name":"Next signal","settings":[{"type":"select","id":"mode","label":"Mode","default":"announcement","options":[{"value":"countdown","label":"Countdown"},{"value":"live","label":"Drop live now"},{"value":"restock","label":"Restock incoming"},{"value":"event","label":"Event"},{"value":"announcement","label":"Announcement"}]},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"NEXT SIGNAL"},{"type":"text","id":"heading","label":"Heading","default":"YOU WILL KNOW WHEN IT IS REAL."},{"type":"textarea","id":"copy","label":"Copy","default":"Get the actual drop date, event location, or restock notice. No invented emergency."},{"type":"text","id":"release_date","label":"Release date and timezone","info":"ISO format recommended: 2026-08-01T12:00:00-04:00"},{"type":"text","id":"live_heading","label":"Expired/live heading","default":"THE DROP IS LIVE."},{"type":"textarea","id":"live_copy","label":"Expired/live copy","default":"The countdown is over. Enter the live collection."},{"type":"text","id":"event_date","label":"Event date"},{"type":"text","id":"event_location","label":"Event location"},{"type":"checkbox","id":"show_signup","label":"Show email signup","default":true},{"type":"text","id":"signup_value","label":"Signup value","default":"EARLY ACCESS, EVENT DETAILS, AND RESTOCK SIGNALS."},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Next signal"}]}{% endschema %}
