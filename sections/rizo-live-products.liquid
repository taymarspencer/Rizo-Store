<section class="live-products page-width" id="RizoLiveShop" data-product-impressions>
  <header class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2>{% if section.settings.text != blank %}<p class="section-intro">{{ section.settings.text }}</p>{% endif %}</div>{% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">{{ section.settings.view_all_label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</header>
  {% assign source = section.settings.collection.products %}
  {% if section.settings.collection != blank and source.size > 0 %}
    <div class="live-products-guide"><span>{{ source.size }} PIECES IN THIS SIGNAL</span><span>Tap a piece for fit, story, and details.</span></div>
    <div class="product-grid product-grid--{{ section.settings.mobile_layout }}">
      {% for product in source limit: section.settings.products_to_show %}{% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add, show_vendor: false, show_artifact_link: section.settings.show_artifact_link, show_size_preview: section.settings.show_size_preview %}{% endfor %}
    </div>
  {% else %}{% if request.design_mode %}<div class="editor-setup-state">Choose the collection that is live before publishing this section.</div>{% else %}<div class="empty-state"><img src="{{ 'rizo-face-white.png' | asset_url }}" width="317" height="360" alt="" loading="lazy"><h3>No pieces are live in this signal.</h3><p>The next release is being prepared. Explore the current world while the signal forms.</p><a class="button button-hot" href="{{ routes.collections_url }}">EXPLORE COLLECTIONS {% render 'icon', name: 'arrow' %}</a></div>{% endif %}{% endif %}
</section>
{% schema %}{"name":"Shop what is live","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"SHOP WHAT IS LIVE"},{"type":"text","id":"heading","label":"Heading","default":"THE PIECES ARE THE PORTAL"},{"type":"textarea","id":"text","label":"Text","default":"The pieces available now—small runs, honest stock, and no invented emergency."},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":12,"step":1,"default":6},{"type":"select","id":"mobile_layout","label":"Mobile layout","default":"track","options":[{"value":"track","label":"Horizontal snap track"},{"value":"grid","label":"Two-column grid"}]},{"type":"checkbox","id":"show_quick_add","label":"Show quick add","default":true},{"type":"checkbox","id":"show_size_preview","label":"Show available size preview","default":true},{"type":"checkbox","id":"show_artifact_link","label":"Show fit, story, and details link","default":true},{"type":"text","id":"view_all_label","label":"View all label","default":"VIEW ALL PIECES"}],"presets":[{"name":"Shop what is live"}]}{% endschema %}
