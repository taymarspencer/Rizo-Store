<section class="worlds page-width">
  <header class="section-heading">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p class="section-intro">{{ section.settings.text }}</p>{% endif %}
    </div>
  </header>

  <div class="world-grid">
    {% for block in section.blocks %}
      {% capture card_content %}
        <div class="world-card-copy">
          {% if block.settings.kicker != blank %}<span>{{ block.settings.kicker }}</span>{% endif %}
          <h3>{{ block.settings.title }}</h3>
          {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
          {% if block.settings.link != blank and block.settings.link_label != blank %}<b>{{ block.settings.link_label }} {% render 'icon', name: 'arrow' %}</b>{% endif %}
        </div>
        <div class="world-card-art" aria-hidden="true">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 900px) 33vw, 90vw', alt: '' }}
          {% else %}
            {% case block.settings.character %}
              {% when 'ember' %}<img src="{{ 'rizo-ember.png' | asset_url }}" width="520" height="670" alt="" loading="lazy">
              {% when 'shadow' %}<img src="{{ 'rizo-shadow.png' | asset_url }}" width="520" height="670" alt="" loading="lazy">
              {% else %}<img src="{{ 'rizo-classic.png' | asset_url }}" width="520" height="670" alt="" loading="lazy">
            {% endcase %}
          {% endif %}
        </div>
      {% endcapture %}

      {% if block.settings.link != blank %}
        <a class="world-card world-card--{{ block.settings.style }}" href="{{ block.settings.link }}" data-tilt {{ block.shopify_attributes }}>{{ card_content }}</a>
      {% else %}
        <article class="world-card world-card--{{ block.settings.style }}" data-tilt {{ block.shopify_attributes }}>{{ card_content }}</article>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name":"Explore Rizo",
  "class":"section-rizo-worlds",
  "max_blocks":3,
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE WORLD BEYOND THE GRID"},
    {"type":"text","id":"heading","label":"Heading","default":"EVERY PIECE LEADS SOMEWHERE"},
    {"type":"textarea","id":"text","label":"Supporting text","default":"Shop what is live, follow the Pittsburgh roots, then see where the clothing goes outside."}
  ],
  "blocks":[
    {
      "type":"gateway",
      "name":"Public gateway",
      "settings":[
        {"type":"text","id":"kicker","label":"Kicker","default":"SHOP"},
        {"type":"text","id":"title","label":"Title","default":"Shop the live signal"},
        {"type":"textarea","id":"text","label":"Text","default":"Current pieces, core forms, and the stock that actually exists."},
        {"type":"text","id":"link_label","label":"Link label","default":"Enter"},
        {"type":"url","id":"link","label":"Link"},
        {"type":"image_picker","id":"image","label":"Custom image"},
        {"type":"select","id":"character","label":"Fallback character","default":"classic","options":[{"value":"classic","label":"Classic"},{"value":"ember","label":"Ember"},{"value":"shadow","label":"Shadow"}]},
        {"type":"select","id":"style","label":"Card style","default":"blue","options":[{"value":"blue","label":"Blue"},{"value":"heat","label":"Heat"},{"value":"night","label":"Night"}]}
      ]
    }
  ],
  "presets":[
    {
      "name":"Explore Rizo",
      "blocks":[
        {"type":"gateway","settings":{"kicker":"SHOP","title":"Wear the world","text":"Drops, staples and pieces made to live with you.","link_label":"Shop Rizo","character":"classic","style":"blue"}},
        {"type":"gateway","settings":{"kicker":"STORY","title":"Why Rizo exists","text":"The people, Pittsburgh roots and belief behind the flame.","link_label":"About Rizo","character":"ember","style":"heat"}},
        {"type":"gateway","settings":{"kicker":"SIGNAL","title":"What’s happening now","text":"New pieces, pop-ups and moments from the community.","link_label":"See the latest","character":"shadow","style":"night"}}
      ]
    }
  ]
}
{% endschema %}
