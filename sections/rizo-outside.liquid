{%- comment -%} Where Rizo will be in person. Past dates dim instead of disappearing. {%- endcomment -%}
<section class="s" data-surface="{{ section.settings.surface }}" data-space="m" data-fog="{{ section.settings.fog | divided_by: 100.0 }}">
  <div class="wrap">
    <div class="s-head">
      <div>
        {%- if section.settings.label != blank -%}<p class="v-label">{{ section.settings.label | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="s-title t-2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="outside-list">
        {%- for block in section.blocks -%}
          <article class="outside-item{% if block.settings.past %} is-past{% endif %}" {{ block.shopify_attributes }}>
            <span class="outside-date">{{ block.settings.date | escape }}</span>
            <div class="outside-what">
              <strong>{{ block.settings.name | escape }}</strong>
              <span>{{ block.settings.place | escape }}{% if block.settings.time != blank %} · {{ block.settings.time | escape }}{% endif %}</span>
            </div>
            {%- if block.settings.link != blank -%}<a class="link" href="{{ block.settings.link }}" target="_blank" rel="noopener"><span>{{ block.settings.link_label | default: 'Map' | escape }}</span><span class="visually-hidden"> (opens in a new tab)</span></a>{%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- elsif section.settings.empty != blank -%}
      <p class="muted">{{ section.settings.empty | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Where we’ll be",
  "tag": "div",
  "class": "section-outside",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "In person" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where we’ll be" },
    { "type": "text", "id": "empty", "label": "When nothing is planned", "default": "Nothing on the calendar right now. Sign up and you’ll hear first." },
    { "type": "select", "id": "surface", "label": "Surface", "default": "solid", "options": [{ "value": "solid", "label": "Solid" }, { "value": "raised", "label": "Raised" }, { "value": "open", "label": "Open sky" }] },
    { "type": "range", "id": "fog", "label": "Fog", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 }
  ],
  "blocks": [
    { "type": "stop", "name": "Date", "settings": [
      { "type": "text", "id": "date", "label": "Date", "default": "10/31" },
      { "type": "text", "id": "name", "label": "What", "default": "Pop-up" },
      { "type": "text", "id": "place", "label": "Where", "default": "Pittsburgh" },
      { "type": "text", "id": "time", "label": "Time" },
      { "type": "url", "id": "link", "label": "Map or ticket link" },
      { "type": "text", "id": "link_label", "label": "Link label", "default": "Map" },
      { "type": "checkbox", "id": "past", "label": "Already happened", "default": false }
    ] }
  ],
  "presets": [{ "name": "Where we’ll be" }]
}
{% endschema %}
