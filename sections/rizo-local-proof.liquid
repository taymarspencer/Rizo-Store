<section class="local-proof page-width"><div class="local-proof-copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><div class="rte">{{ section.settings.copy }}</div></div><div class="proof-points">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div>{% endfor %}</div>{% render 'rizo-character', variant: section.settings.character, size: 180, message: section.settings.rizo_message, alt: 'Rizo beside the local proof section' %}</section>
{% schema %}{"name":"Pittsburgh proof","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BUILT HERE"},{"type":"text","id":"heading","label":"Heading","default":"PITTSBURGH BUILT THE PRESSURE. RIZO BUILT A WAY OUT."},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Rizo began without a blueprint or deep resources. Taymar designs and makes the clothes himself, learning through the work and growing with help from people who showed up along the way.</p>"},{"type":"select","id":"character","label":"Rizo character","default":"ember","options":[{"value":"classic","label":"Classic"},{"value":"ember","label":"Ember"},{"value":"shadow","label":"Shadow"}]},{"type":"text","id":"rizo_message","label":"Rizo message","default":"MAKE WITH WHAT YOU HAVE."}],"blocks":[{"type":"point","name":"Proof point","settings":[{"type":"text","id":"title","label":"Title","default":"SMALL RUNS"},{"type":"textarea","id":"text","label":"Text","default":"Made in quantities that match a real independent brand."}]}],"presets":[{"name":"Pittsburgh proof","blocks":[{"type":"point"},{"type":"point"},{"type":"point"}]}]}{% endschema %}
