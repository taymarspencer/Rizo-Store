<section class="signal-signup page-width" id="RizoSignal">
  <div>
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    {% if section.settings.value != blank %}<p>{{ section.settings.value }}</p>{% endif %}
    {% if section.settings.shop_label != blank %}<a class="text-link signal-signup-shop" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">{{ section.settings.shop_label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}
  </div>
  {% form 'customer', class: 'newsletter-form newsletter-form--large' %}
    {% assign signal_error_id = 'SignalError-' | append: section.id %}
    <input type="hidden" name="contact[tags]" value="newsletter, get-the-signal">
    <div class="newsletter-field">
      <label class="visually-hidden" for="FooterSignal-{{ section.id }}">Email address</label>
      <input id="FooterSignal-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required placeholder="YOUR EMAIL"{% if form.errors %} aria-invalid="true" aria-describedby="{{ signal_error_id }}"{% endif %}>
      <button class="button button-hot" type="submit">KEEP ME POSTED</button>
    </div>
    {% if form.posted_successfully? %}<p class="form-message" role="status" tabindex="-1" data-form-feedback>You have the signal.</p>{% endif %}
    {% if form.errors %}<div id="{{ signal_error_id }}" class="form-message form-message--error" role="alert" tabindex="-1" data-form-feedback>{{ form.errors | default_errors }}</div>{% endif %}
  {% endform %}
</section>
{% schema %}
{
  "name":"Get the signal signup",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"GET THE SIGNAL"},
    {"type":"text","id":"heading","label":"Heading","default":"KNOW WHAT ENTERS THE WORLD NEXT."},
    {"type":"textarea","id":"value","label":"Value statement","default":"Drop dates, Pittsburgh event locations, and restock notices—only when there is something real to send."},
    {"type":"text","id":"shop_label","label":"Shop link label","default":"SHOP WHAT IS LIVE"},
    {"type":"url","id":"shop_link","label":"Shop link"}
  ],
  "presets":[{"name":"Get the signal signup"}]
}
{% endschema %}
