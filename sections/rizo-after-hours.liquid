<section class="after-hours page-width" id="RizoWorldMap" aria-labelledby="AfterHours-{{ section.id }}">
  <div class="after-hours-heading">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 id="AfterHours-{{ section.id }}">{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <a class="text-link" href="{{ section.settings.link | default: '/pages/world' }}">ENTER RIZO WORLD {% render 'icon', name: 'arrow' %}</a>
  </div>
  <details class="origin-pocket">
    <summary aria-label="Open the first Rizo drawing">
      <span class="pocket-file">RIZO / FIRST DRAWING</span>
      <img class="pocket-mark" src="{{ 'rizo-logo-white.webp' | asset_url }}" width="600" height="780" loading="lazy" alt="">
      <span class="pocket-hint">STARTED SOMEWHERE. <span aria-hidden="true">↗</span></span>
    </summary>
    <figure class="pocket-reveal">
      <img src="{{ 'rizo-origin-sketch.webp' | asset_url }}" width="1152" height="1536" loading="lazy" alt="The original pencil drawing of the Rizo flame, on a real sketchbook page">
      <figcaption>Before the clothes. Before all of this.</figcaption>
    </figure>
  </details>
</section>
{% schema %}
{
  "name": "Beyond the clothes",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"BEYOND THE CLOTHES"},
    {"type":"text","id":"heading","label":"Heading","default":"THERE’S MORE IN HERE."},
    {"type":"textarea","id":"text","label":"Text","default":"The first drawing. The experiments. The things that don’t fit on a shirt."},
    {"type":"url","id":"link","label":"World page link"}
  ],
  "presets":[{"name":"Beyond the clothes"}]
}
{% endschema %}
