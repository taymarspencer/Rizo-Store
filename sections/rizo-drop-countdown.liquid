<section class="drop-zone drop-zone--{{ section.settings.theme }}" data-countdown-root{% if section.settings.date != blank %} data-countdown="{{ section.settings.date | escape }}"{% endif %}>
  <div class="drop-copy">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    {% if section.settings.button_label != blank %}
      <a class="text-arrow" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}{% render 'icon', name: 'arrow' %}
      </a>
    {% endif %}
  </div>

  {% if section.settings.date != blank %}
    <div class="countdown" role="timer" aria-label="Countdown to the next Rizo drop" data-countdown-display>
      <div><strong data-days>00</strong><span>Days</span></div>
      <div><strong data-hours>00</strong><span>Hours</span></div>
      <div><strong data-minutes>00</strong><span>Minutes</span></div>
      <div><strong data-seconds>00</strong><span>Seconds</span></div>
    </div>
    <p class="countdown-live" role="status" aria-live="polite" data-countdown-live hidden>{{ section.settings.live_text }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name":"Drop signal",
  "class":"section-drop-signal",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"NEXT SIGNAL"},
    {"type":"text","id":"heading","label":"Heading","default":"THE NEXT SIGNAL HAS A TIME"},
    {"type":"textarea","id":"text","label":"Text","default":"Pittsburgh time. A real release. When the clock clears, the piece enters the world."},
    {"type":"text","id":"date","label":"Launch date (ISO format)","info":"Example: 2026-12-01T20:00:00-05:00. Leave blank until the release time is real."},
    {"type":"text","id":"live_text","label":"Message after countdown","default":"THE SIGNAL IS LIVE. ENTER NOW."},
    {"type":"text","id":"button_label","label":"Link label","default":"SHOP THE LIVE SIGNAL"},
    {"type":"url","id":"button_link","label":"Link"},
    {"type":"select","id":"theme","label":"Color theme","default":"paper","options":[{"value":"paper","label":"Paper"},{"value":"dark","label":"Dark"}]}
  ],
  "presets":[{"name":"Drop signal"}]
}
{% endschema %}
