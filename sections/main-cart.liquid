{%- liquid
  assign shipping_threshold = settings.free_shipping_threshold | times: 100
  assign shipping_remaining = shipping_threshold | minus: cart.total_price
  assign shipping_percent = 0
  if shipping_threshold > 0
    assign shipping_percent = cart.total_price | times: 100 | divided_by: shipping_threshold | at_most: 100
  endif
-%}
{% render 'page-head', title: 'Cart', crumbs: true, fog: 0.3 %}
<section class="s cart-page" data-surface="solid" data-space="s" data-fog="0" data-rizo-event-quiet>
  <div class="wrap wrap--wide">
    {%- if cart.item_count == 0 -%}
      <div class="empty">
        <h2>Nothing in here yet.</h2>
        <p>Everything that’s available is in the shop.</p>
        <a class="btn btn--solid" href="{{ routes.all_products_collection_url }}">Shop{% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-layout">
          <div class="cart-lines">
            {%- for item in cart.items -%}
              <article class="cart-row">
                <a class="cart-row-img" href="{{ item.url }}" tabindex="-1" aria-hidden="true">{%- if item.image -%}{{ item.image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '160,240,360,420', sizes: '104px', alt: '' }}{%- endif -%}</a>
                <div class="cart-row-copy">
                  <a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>
                  {%- unless item.product.has_only_default_variant -%}<p>{{ item.variant.title }}</p>{%- endunless -%}
                  {%- if item.selling_plan_allocation -%}<small>{{ item.selling_plan_allocation.selling_plan.name }}</small>{%- endif -%}
                  {%- for property in item.properties -%}{%- assign property_first_char = property.first | slice: 0 -%}{%- unless property.last == blank or property_first_char == '_' -%}<small>{{ property.first }}: {{ property.last }}</small>{%- endunless -%}{%- endfor -%}
                  {%- if item.line_level_discount_allocations.size > 0 -%}<ul class="cart-discounts">{%- for discount in item.line_level_discount_allocations -%}<li>{{ discount.discount_application.title }} (−{{ discount.amount | money }})</li>{%- endfor -%}</ul>{%- endif -%}
                  <a class="cart-remove" href="{{ item.url_to_remove }}">Remove</a>
                </div>
                <div class="quantity-control">
                  <button type="button" data-quantity-step="-1" aria-label="One fewer {{ item.product.title | escape }}">{% render 'icon', name: 'minus' %}</button>
                  <label class="visually-hidden" for="Quantity-{{ forloop.index }}">Quantity of {{ item.product.title }}</label>
                  <input id="Quantity-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                  <button type="button" data-quantity-step="1" aria-label="One more {{ item.product.title | escape }}">{% render 'icon', name: 'plus' %}</button>
                </div>
                <strong class="cart-row-price">{{ item.final_line_price | money }}</strong>
              </article>
            {%- endfor -%}
          </div>

          <aside class="cart-sum">
            <h2>Summary</h2>
            {%- if shipping_threshold > 0 -%}
              <div class="ship-bar"><span>{% if shipping_remaining > 0 %}{{ shipping_remaining | money }} away from free shipping{% else %}Free shipping{% endif %}</span><i><span style="width: {{ shipping_percent }}%"></span></i></div>
            {%- endif -%}
            <div class="cart-total"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
            {%- if cart.cart_level_discount_applications.size > 0 -%}<ul class="cart-discounts">{%- for discount in cart.cart_level_discount_applications -%}<li>{{ discount.title }} (−{{ discount.total_allocated_amount | money }})</li>{%- endfor -%}</ul>{%- endif -%}
            <p>Shipping and taxes are worked out at checkout.</p>
            {%- if section.settings.show_note -%}<label class="field"><span>Note</span><textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea></label>{%- endif -%}
            <button class="btn btn--solid btn--full" type="submit" name="checkout" data-analytics="checkout_clicked">Check out</button>
            <button class="btn btn--line btn--full" type="submit" name="update">Update cart</button>
            {%- if shop.refund_policy != blank -%}<a class="v-note" href="{{ shop.refund_policy.url }}">Returns and exchanges</a>{%- endif -%}
          </aside>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>
{% schema %}{ "name": "Cart", "settings": [{ "type": "checkbox", "id": "show_note", "label": "Order note", "default": true }] }{% endschema %}
