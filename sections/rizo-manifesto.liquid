<section class="manifesto page-width"><div class="manifesto-statement"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.statement }}</h2></div><div class="manifesto-support">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000', sizes: '(min-width:900px) 34vw,100vw', alt: section.settings.image.alt }}{% endif %}<div class="rte">{{ section.settings.supporting_copy }}</div>{% if section.settings.link_label != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></section>
{% schema %}{"name":"Campaign manifesto","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE BELIEF"},{"type":"textarea","id":"statement","label":"Major sentence","default":"THE BOX WAS REAL. SO WAS THE WAY OUT."},{"type":"richtext","id":"supporting_copy","label":"Supporting paragraph","default":"<p>Rizo began before the resources, roadmap or confidence arrived. The limitation was not hidden—it became the first material. Every piece is proof that expression can start before everything is figured out.</p>"},{"type":"image_picker","id":"image","label":"Founder or community image"},{"type":"text","id":"link_label","label":"Link label","default":"READ THE FULL ORIGIN"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Campaign manifesto"}]}{% endschema %}
