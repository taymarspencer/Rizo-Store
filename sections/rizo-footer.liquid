<footer class="site-footer site-footer--v5{% if request.page_type == 'index' %} site-footer--home{% endif %}">
  <div class="page-width footer-signal-line">
    {% render 'rizo-dateline', label: section.settings.dateline_label %}
    <img class="footer-secondary-face" src="{{ 'rizo-secondary-face.png' | asset_url }}" width="317" height="178" alt="" aria-hidden="true">
  </div>

  <div class="page-width footer-grid">
    <div class="footer-brand">
      <a class="footer-mark" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
        {% if settings.logo != blank %}
          {{ settings.logo | image_url: width: 260 | image_tag: loading: 'lazy', widths: '160,260', sizes: '120px', alt: shop.name }}
        {% else %}
          {% render 'rizo-brand-stamp', variant: 'logo', class: 'footer-primary-logo' %}
        {% endif %}
      </a>
      <p class="footer-catalog">{{ settings.catalog_prefix | default: 'RZ' }} / PITTSBURGH / 412</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.tagline }}</p>
      {% liquid
        assign contact_url = section.settings.contact_link
        if contact_url == blank
          assign contact_url = routes.root_url | append: 'pages/contact'
        endif
      %}
      <div class="footer-brand-actions">
        <a class="footer-contact-link button button-ghost" href="{{ contact_url }}">CONTACT RIZO {% render 'icon', name: 'arrow' %}</a>
        <a class="text-link footer-circle-link" href="{{ routes.root_url }}#RizoCircle">THE RIZO CIRCLE {% render 'icon', name: 'arrow' %}</a>
      </div>
    </div>

    {% unless request.page_type == 'index' %}
      <div class="footer-newsletter">
        <p class="eyebrow">{{ section.settings.newsletter_eyebrow }}</p>
        <h3>{{ section.settings.newsletter_heading }}</h3>
        {% form 'customer', class: 'newsletter-form' %}
          {% assign footer_error_id = 'FooterEmailError-' | append: section.id %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label>
          <div class="newsletter-field">
            <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="Email address" required{% if form.errors %} aria-invalid="true" aria-describedby="{{ footer_error_id }}"{% endif %}>
            <button type="submit" aria-label="Join the Rizo list">{% render 'icon', name: 'arrow' %}</button>
          </div>
          {% if form.posted_successfully? %}<p class="form-message" role="status" tabindex="-1" data-form-feedback>You’re in. Watch for the next signal.</p>{% endif %}
          {% if form.errors %}<div id="{{ footer_error_id }}" class="form-message form-message--error" role="alert" tabindex="-1" data-form-feedback>{{ form.errors | default_errors }}</div>{% endif %}
        {% endform %}
        <small>{{ section.settings.newsletter_note }}</small>
      </div>
    {% endunless %}

    <nav class="footer-links" aria-label="Footer navigation">
      <div>
        <span>Explore</span>
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}"><small>{{ forloop.index | prepend: '0' }}</small>{{ link.title }}</a>{% endfor %}
      </div>
      <div>
        <span>Info</span>
        {% for link in section.settings.secondary_menu.links %}<a href="{{ link.url }}"><small>{{ forloop.index | prepend: '0' }}</small>{{ link.title }}</a>{% endfor %}
      </div>
    </nav>
  </div>

  <div class="page-width footer-bottom">
    <small>© {{ 'now' | date: '%Y' }} Rizo Apparel LLC · Pittsburgh, PA</small>
    <div class="footer-socials">
      {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" rel="noopener" target="_blank">Instagram<span class="visually-hidden"> (opens in a new tab)</span></a>{% endif %}
      {% if section.settings.tiktok_url != blank %}<a href="{{ section.settings.tiktok_url }}" rel="noopener" target="_blank">TikTok<span class="visually-hidden"> (opens in a new tab)</span></a>{% endif %}
    </div>
    <small>{{ section.settings.bottom_note }}</small>
  </div>
</footer>

{% schema %}
{
  "name":"Rizo footer",
  "settings":[
    {"type":"text","id":"dateline_label","label":"Dateline label","default":"ORIGINAL SIGNAL / STILL MOVING"},
    {"type":"text","id":"heading","label":"Heading","default":"KEEP A LITTLE FIRE WITH YOU."},
    {"type":"textarea","id":"tagline","label":"Tagline","default":"Clothing, characters and experiences made in Pittsburgh."},
    {"type":"text","id":"newsletter_eyebrow","label":"Newsletter eyebrow","default":"GET THE SIGNAL"},
    {"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"Drops without the noise."},
    {"type":"text","id":"newsletter_note","label":"Newsletter note","default":"First notice of pieces, restocks, and where Rizo is outside. Leave anytime."},
    {"type":"link_list","id":"menu","label":"Explore menu","default":"main-menu"},
    {"type":"link_list","id":"secondary_menu","label":"Information menu","default":"footer"},
    {"type":"url","id":"contact_link","label":"Contact page link"},
    {"type":"url","id":"instagram_url","label":"Instagram URL"},
    {"type":"url","id":"tiktok_url","label":"TikTok URL"},
    {"type":"text","id":"bottom_note","label":"Bottom note","default":"A SMALL WORLD THAT KEEPS GETTING BIGGER."}
  ]
}
{% endschema %}
