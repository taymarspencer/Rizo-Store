{%- comment -%}
  The ground. The sky above it is open: fog settles here, the moon goes
  down behind it, and a small flame stays lit on the horizon.
{%- endcomment -%}
<footer class="foot">
  <div class="foot-sky s" data-surface="open" data-fog="1" data-fog-bias="ground" data-roost-skip>
    {% render 'rizo-art', section: section %}
    <div class="foot-flame" data-rizo-flame>{% render 'rizo-mark' %}</div>
  </div>

  <div class="foot-ground">
    <div class="wrap foot-grid">
      <div class="foot-brand">
        <span class="brand-word" aria-hidden="true">RIZO</span>
        {%- if section.settings.tagline != blank -%}<p>{{ section.settings.tagline }}</p>{%- endif -%}
      </div>

      <nav class="foot-nav" aria-label="Footer">
        {%- if section.settings.menu.links.size > 0 -%}
          <div>
            <h2>{{ section.settings.menu_heading | default: 'Rizo' }}</h2>
            {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- endfor -%}
          </div>
        {%- endif -%}
        {%- if section.settings.secondary_menu.links.size > 0 and section.settings.secondary_menu.handle != section.settings.menu.handle -%}
          <div>
            <h2>{{ section.settings.secondary_heading | default: 'Help' }}</h2>
            {%- for link in section.settings.secondary_menu.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- endfor -%}
          </div>
        {%- endif -%}
      </nav>

      {%- unless request.page_type == 'index' -%}
        <div class="foot-news">
          <h2>{{ section.settings.newsletter_heading }}</h2>
          {%- form 'customer', class: 'news-form' -%}
            {%- assign footer_error_id = 'FooterEmailError-' | append: section.id -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email</label>
            <div class="news-field">
              <input class="input" id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="Email" required{% if form.errors %} aria-invalid="true" aria-describedby="{{ footer_error_id }}"{% endif %}>
              <button class="btn btn--line" type="submit">Sign up</button>
            </div>
            {%- if form.posted_successfully? -%}<p class="form-message" role="status" tabindex="-1" data-form-feedback>You’re on the list.</p>{%- endif -%}
            {%- if form.errors -%}<p id="{{ footer_error_id }}" class="form-message form-message--error" role="alert" tabindex="-1" data-form-feedback>{{ form.errors | default_errors }}</p>{%- endif -%}
          {%- endform -%}
          {%- if section.settings.newsletter_note != blank -%}<p>{{ section.settings.newsletter_note }}</p>{%- endif -%}
        </div>
      {%- endunless -%}
    </div>

    <div class="wrap foot-base">
      <span>© {{ 'now' | date: '%Y' }} Rizo Apparel LLC · Pittsburgh, PA</span>
      <div class="cluster">
        {%- if section.settings.instagram_url != blank -%}<a href="{{ section.settings.instagram_url }}" rel="noopener" target="_blank">Instagram<span class="visually-hidden"> (opens in a new tab)</span></a>{%- endif -%}
        {%- if section.settings.tiktok_url != blank -%}<a href="{{ section.settings.tiktok_url }}" rel="noopener" target="_blank">TikTok<span class="visually-hidden"> (opens in a new tab)</span></a>{%- endif -%}
        {%- if section.settings.bottom_note != blank -%}<span class="foot-note">{{ section.settings.bottom_note }}</span>{%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Line under the name", "default": "Clothes made in Pittsburgh." },
    { "type": "link_list", "id": "menu", "label": "First menu", "default": "main-menu" },
    { "type": "text", "id": "menu_heading", "label": "First menu heading", "default": "Rizo" },
    { "type": "link_list", "id": "secondary_menu", "label": "Second menu", "default": "footer", "info": "Shipping, returns, FAQ. Hidden when it is the same menu as the first." },
    { "type": "text", "id": "secondary_heading", "label": "Second menu heading", "default": "Help" },
    { "type": "text", "id": "newsletter_heading", "label": "Sign-up heading", "default": "Hear about new pieces first." },
    { "type": "text", "id": "newsletter_note", "label": "Sign-up note", "default": "Drops, restocks, and where we’ll be. Not much else." },
    { "type": "url", "id": "instagram_url", "label": "Instagram" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok" },
    { "type": "text", "id": "bottom_note", "label": "Fine print", "info": "The last thing on every page. Leave blank to hide." }
  ],
  "blocks": [
    {
      "type": "art",
      "name": "Art",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Artwork", "info": "Transparent PNG or WebP works best. Later blocks sit on top of earlier ones." },
        { "type": "image_picker", "id": "image_mobile", "label": "Phone version", "info": "Optional: a different crop, or a different piece, for phones." },
        { "type": "header", "content": "Placement" },
        { "type": "range", "id": "x", "label": "Across", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 80, "info": "Where the centre of the piece sits, as a share of the section." },
        { "type": "range", "id": "y", "label": "Down", "min": -20, "max": 120, "step": 2, "unit": "%", "default": 30, "info": "Below 0 or above 100 hangs over the edge of the section." },
        { "type": "range", "id": "size", "label": "Size", "min": 4, "max": 140, "step": 2, "unit": "%", "default": 22, "info": "Width, as a share of the section's width." },
        { "type": "range", "id": "rotate", "label": "Turn", "min": -180, "max": 180, "step": 5, "unit": "°", "default": 0 },
        { "type": "range", "id": "opacity", "label": "Opacity", "min": 5, "max": 100, "step": 5, "unit": "%", "default": 100 },
        { "type": "select", "id": "layer", "label": "Layer", "default": "back", "options": [
          { "value": "back", "label": "Behind the content" },
          { "value": "front", "label": "In front of the content" },
          { "value": "back-front", "label": "Behind on desktop, in front on phones" },
          { "value": "front-back", "label": "In front on desktop, behind on phones" }
        ] },
        { "type": "select", "id": "blend", "label": "Blend", "default": "normal", "options": [
          { "value": "normal", "label": "Normal" },
          { "value": "screen", "label": "Screen (only lightens)" },
          { "value": "multiply", "label": "Multiply (only darkens)" },
          { "value": "overlay", "label": "Overlay" },
          { "value": "soft-light", "label": "Soft light" },
          { "value": "difference", "label": "Difference" },
          { "value": "luminosity", "label": "Luminosity" }
        ] },
        { "type": "header", "content": "Phones" },
        { "type": "select", "id": "show", "label": "Show on", "default": "all", "options": [
          { "value": "all", "label": "Desktop and phones" },
          { "value": "desktop", "label": "Desktop only" },
          { "value": "phone", "label": "Phones only" }
        ] },
        { "type": "range", "id": "mobile_x", "label": "Across on phones", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 80 },
        { "type": "range", "id": "mobile_y", "label": "Down on phones", "min": -20, "max": 120, "step": 2, "unit": "%", "default": 20 },
        { "type": "range", "id": "mobile_size", "label": "Size on phones", "min": 4, "max": 140, "step": 2, "unit": "%", "default": 40 },
        { "type": "header", "content": "Movement" },
        { "type": "select", "id": "motion", "label": "Movement", "default": "none", "options": [
          { "value": "none", "label": "Still" },
          { "value": "float", "label": "Floats" },
          { "value": "sway", "label": "Sways from its top edge" },
          { "value": "depth", "label": "Depth: drifts as the page scrolls" },
          { "value": "settle", "label": "Settles into place when it appears" },
          { "value": "shy", "label": "Moves away from the pointer or finger" },
          { "value": "wobble", "label": "Wobbles when touched" },
          { "value": "spin", "label": "Spins when touched" }
        ] },
        { "type": "range", "id": "strength", "label": "How much", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "type": "select", "id": "when", "label": "When", "default": "always", "options": [
          { "value": "always", "label": "Always" },
          { "value": "event", "label": "Only while a seasonal event is on" },
          { "value": "normal", "label": "Only when no event is on" }
        ] },
        { "type": "text", "id": "name", "label": "Name for custom CSS", "info": "Optional. Adds data-art=\"name\" to the piece." }
      ]
    }
  ]
}
{% endschema %}
