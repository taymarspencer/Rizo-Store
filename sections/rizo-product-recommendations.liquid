<product-recommendations class="s" data-surface="solid" data-space="s" data-fog="0" data-rizo-event-quiet data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related">
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="wrap wrap--wide">
      <div class="s-head"><h2 class="v-label">{{ section.settings.heading | escape }}</h2></div>
      <div class="grid-products" data-count="{{ recommendations.products_count | at_most: 4 }}">
        {%- for product in recommendations.products -%}{% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add %}{%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</product-recommendations>
{% schema %}
{
  "name": "Related pieces",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Goes with" },
    { "type": "range", "id": "products_to_show", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Quick add", "default": true }
  ]
}
{% endschema %}
