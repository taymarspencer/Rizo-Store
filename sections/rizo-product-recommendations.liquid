<product-recommendations class="recommendations-section page-width" data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related">
  {% if recommendations.performed? and recommendations.products_count > 0 %}
    <header class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="section-intro">{{ section.settings.text }}</p></div></header>
    <div class="product-grid product-grid--recommendations">{% for product in recommendations.products %}{% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add, show_size_preview: true %}{% endfor %}</div>
  {% endif %}
</product-recommendations>
{% schema %}{"name":"Complete the world","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"COMPLETE THE WORLD"},{"type":"text","id":"heading","label":"Heading","default":"THESE PIECES SPEAK TO EACH OTHER"},{"type":"textarea","id":"text","label":"Text","default":"Related pieces chosen from the same world—not a wall of random upsells."},{"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":8,"step":1,"default":4},{"type":"checkbox","id":"show_quick_add","label":"Show quick add","default":true}]}{% endschema %}
