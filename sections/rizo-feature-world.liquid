{{ 'rizo-worlds.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign load = 'lazy'
  if section.index == 1
    assign load = 'eager'
  endif
  assign has_mark = false
  if s.heading_art != blank or s.builtin_mark != 'none'
    assign has_mark = true
  endif
-%}
<section class="s world-portal world-portal--{{ s.text_position }} world-portal--{{ s.phone_layout }} world-visible--{{ s.visibility }}" data-surface="{{ s.surface }}" data-space="{{ s.space }}" data-fog="0" style="--world-accent: {{ s.accent }}; --world-x: {{ s.crop_x }}%; --world-y: {{ s.crop_y }}%; --world-mobile-x: {{ s.phone_crop_x }}%; --world-mobile-y: {{ s.phone_crop_y }}%;" aria-labelledby="WorldTitle-{{ section.id }}">
  {% render 'rizo-art', section: section %}
  <div class="wrap wrap--wide world-grid">
    <div class="world-copy">
      {%- if s.eyebrow != blank -%}<p class="v-label world-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.page_heading -%}<h1 id="WorldTitle-{{ section.id }}" class="world-title{% if has_mark %} visually-hidden{% endif %}">{{ s.heading | escape }}</h1>
      {%- else -%}<h2 id="WorldTitle-{{ section.id }}" class="world-title{% if has_mark %} visually-hidden{% endif %}">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if has_mark -%}<div class="world-heading-art" aria-hidden="true">{% render 'rizo-image', image: s.heading_art, builtin: s.builtin_mark, alt: '', sizes: '(min-width: 750px) 300px, 180px', loading: load %}</div>{%- endif -%}
      {%- if s.body != blank -%}<div class="world-body rte">{{ s.body }}</div>{%- endif -%}
      {%- if s.link != blank and s.link_label != blank -%}<a class="link world-link" href="{{ s.link }}"><span>{{ s.link_label | escape }}</span>{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </div>
    <figure class="world-primary world-crop--{{ s.crop }}">
      {% render 'rizo-image', image: s.image, mobile_image: s.image_mobile, builtin: s.builtin_image, alt: s.image_alt, sizes: '(min-width: 750px) 52vw, 100vw', loading: load %}
      {%- if s.caption != blank -%}<figcaption>{{ s.caption | escape }}</figcaption>{%- endif -%}
    </figure>
    {%- if s.secondary_image != blank or s.secondary_builtin != 'none' -%}
      <figure class="world-secondary">
        {% render 'rizo-image', image: s.secondary_image, mobile_image: s.secondary_mobile, builtin: s.secondary_builtin, alt: s.secondary_alt, sizes: '(min-width: 750px) 240px, 42vw' %}
        {%- if s.secondary_caption != blank -%}<figcaption>{{ s.secondary_caption | escape }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
