{%- liquid
  assign trail_image = blank
  if product.featured_image != blank
    assign trail_image = product.featured_image | image_url: width: 720
  endif
-%}
<section class="s" data-surface="solid" data-space="s" data-fog="0" data-rizo-event-quiet data-recently-viewed hidden>
  <script type="application/json" data-current-product>{"id":{{ product.id | json }},"title":{{ product.title | json }},"url":{{ product.url | json }},"image":{{ trail_image | json }},"price":{{ product.price | money | json }}}</script>
  <div class="wrap wrap--wide">
    <div class="s-head"><h2 class="v-label">{{ section.settings.heading | escape }}</h2></div>
    <div class="shelf-track" data-recent-trail></div>
  </div>
</section>
{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You looked at" }
  ]
}
{% endschema %}
