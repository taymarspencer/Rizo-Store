{% liquid
  assign built_in_portrait = section.settings.built_in_portrait | default: 'founder_mural'
  assign portrait_asset = blank
  assign portrait_width = 1152
  assign portrait_height = 1536

  case built_in_portrait
    when 'founder_full_fit'
      assign portrait_asset = 'rizo-founder-full-fit.webp'
      assign portrait_width = 1024
      assign portrait_height = 1536
    when 'none'
      assign portrait_asset = blank
    else
      assign portrait_asset = 'rizo-founder-mural.webp'
  endcase

  assign has_portrait = false
  if section.settings.portrait != blank or portrait_asset != blank
    assign has_portrait = true
  endif

  assign founder_ready = false
  if has_portrait and section.settings.bio != blank
    assign founder_ready = true
  endif

  assign archive_photo_count = 0
  assign quote_count = 0
  for block in section.blocks
    if block.type == 'photo'
      assign block_archive_asset = block.settings.archive_asset | default: 'none'
      if block.settings.image != blank or block_archive_asset != 'none'
        assign archive_photo_count = archive_photo_count | plus: 1
      endif
    elsif block.type == 'quote' and block.settings.quote != blank
      assign quote_count = quote_count | plus: 1
    endif
  endfor
%}

{% if founder_ready %}
  <section class="founder-signal page-width" id="RizoFounderSignal">
    <img class="founder-signal-watermark" src="{{ 'rizo-logo-outline.png' | asset_url }}" width="1200" height="1200" loading="lazy" alt="" aria-hidden="true">

    <div class="founder-signal-media">
      <figure class="founder-signal-portrait">
        {% if section.settings.portrait != blank %}
          {{ section.settings.portrait | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '480,720,1000,1400,1800', sizes: '(min-width: 900px) 52vw, 100vw', alt: section.settings.portrait_alt | default: section.settings.founder_name | default: section.settings.heading }}
        {% else %}
          <img src="{{ portrait_asset | asset_url }}" width="{{ portrait_width }}" height="{{ portrait_height }}" loading="lazy" alt="{{ section.settings.portrait_alt | default: 'Taymar Spencer wearing a black Rizo shirt in front of a Pittsburgh mural' | escape }}">
        {% endif %}
        {% if section.settings.portrait_caption != blank %}<figcaption>{{ section.settings.portrait_caption }}</figcaption>{% endif %}
      </figure>

      {% if section.settings.show_origin_marks %}
        <div class="founder-origin-lineage" role="list" aria-label="Evolution of the Rizo mark">
          <figure class="founder-origin-artifact founder-origin-artifact--paper" role="listitem">
            <img src="{{ 'rizo-origin-sketch.webp' | asset_url }}" width="1152" height="1536" loading="lazy" alt="The original hand-drawn Rizo flame character">
            <figcaption><span>ORIGIN 01</span>THE FIRST DRAWING</figcaption>
          </figure>
          <figure class="founder-origin-artifact founder-origin-artifact--face" role="listitem">
            <img src="{{ 'rizo-face-basic.png' | asset_url }}" width="800" height="800" loading="lazy" alt="Early simplified Rizo face design">
            <figcaption><span>ORIGIN 02</span>THE FACE FORMS</figcaption>
          </figure>
          <figure class="founder-origin-artifact founder-origin-artifact--mark" role="listitem">
            <img src="{{ 'rizo-origin-mark.png' | asset_url }}" width="1000" height="1000" loading="lazy" alt="The finished blue and white Rizo flame mark">
            <figcaption><span>ORIGIN 03</span>THE SIGNAL NOW</figcaption>
          </figure>
        </div>
      {% endif %}

      {% if archive_photo_count > 0 %}
        <div class="founder-signal-archive" role="list" aria-label="Founder and Rizo archive photos">
          {% for block in section.blocks %}
            {% if block.type == 'photo' %}
              {% liquid
                assign fallback_asset = blank
                assign fallback_width = 1152
                assign fallback_height = 1536
                assign archive_asset = block.settings.archive_asset | default: 'none'
                case archive_asset
                  when 'founder_mural'
                    assign fallback_asset = 'rizo-founder-mural.webp'
                  when 'founder_full_fit'
                    assign fallback_asset = 'rizo-founder-full-fit.webp'
                    assign fallback_width = 1024
                  when 'community_create'
                    assign fallback_asset = 'rizo-community-create.webp'
                    assign fallback_width = 1536
                    assign fallback_height = 1152
                  when 'community_table'
                    assign fallback_asset = 'rizo-community-table.webp'
                  when 'stadium'
                    assign fallback_asset = 'rizo-412-stadium.webp'
                  when 'underpass'
                    assign fallback_asset = 'rizo-412-underpass.webp'
                  when 'circle_night'
                    assign fallback_asset = 'rizo-circle-night.webp'
                endcase
              %}
              {% if block.settings.image != blank or fallback_asset != blank %}
                <figure role="listitem" {{ block.shopify_attributes }}>
                  {% if block.settings.image != blank %}
                    {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240,360,540,720,900', sizes: '(min-width: 900px) 17vw, 62vw', alt: block.settings.alt | default: block.settings.caption }}
                  {% else %}
                    <img src="{{ fallback_asset | asset_url }}" width="{{ fallback_width }}" height="{{ fallback_height }}" loading="lazy" alt="{{ block.settings.alt | default: block.settings.caption | escape }}">
                  {% endif %}
                  {% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption }}</figcaption>{% endif %}
                </figure>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="founder-signal-copy">
      {% if section.settings.show_dateline %}{% render 'rizo-dateline', label: section.settings.dateline_label %}{% endif %}
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.founder_name != blank %}<p class="founder-signal-name">{{ section.settings.founder_name }}{% if section.settings.location_line != blank %}<span>{{ section.settings.location_line }}</span>{% endif %}</p>{% endif %}
      <div class="rte founder-signal-bio">{{ section.settings.bio }}</div>

      {% if quote_count > 0 %}
        <div class="founder-signal-quotes" role="region" aria-label="Founder words">
          {% for block in section.blocks %}
            {% if block.type == 'quote' and block.settings.quote != blank %}
              <blockquote {{ block.shopify_attributes }}>
                <p>{{ block.settings.quote }}</p>
                {% if block.settings.attribution != blank %}<cite>{{ block.settings.attribution }}</cite>{% endif %}
              </blockquote>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.link_label != blank and section.settings.link != blank %}<a class="text-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>{% endif %}
    </div>
  </section>
{% elsif request.design_mode %}
  <div class="editor-setup-state page-width">Add a real founder portrait and founder bio before this section can publish. The built-in Rizo archive can be disabled or replaced at any time.</div>
{% endif %}

{% schema %}
{
  "name":"Founder signal",
  "tag":"section",
  "class":"section-founder-signal",
  "max_blocks":12,
  "settings":[
    {"type":"checkbox","id":"show_dateline","label":"Show founder fileline","default":false},
    {"type":"text","id":"dateline_label","label":"Fileline label","default":"FOUNDER FILE / PITTSBURGH"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"FOUNDER SIGNAL"},
    {"type":"text","id":"heading","label":"Heading","default":"BUILT THROUGH LIMITATIONS. MADE TO BREAK OUT."},
    {"type":"text","id":"founder_name","label":"Founder name","default":"TAYMAR SPENCER"},
    {"type":"text","id":"location_line","label":"Location or role line","default":"FOUNDER & BRAND OWNER / PITTSBURGH"},
    {"type":"image_picker","id":"portrait","label":"Optional replacement founder photo"},
    {"type":"select","id":"built_in_portrait","label":"Built-in founder photo","default":"founder_mural","options":[{"value":"founder_mural","label":"Founder at Pittsburgh mural"},{"value":"founder_full_fit","label":"Founder in full Rizo fit"},{"value":"none","label":"None"}]},
    {"type":"text","id":"portrait_alt","label":"Primary photo alt text","default":"Taymar Spencer wearing a black Rizo shirt in front of a Pittsburgh mural"},
    {"type":"text","id":"portrait_caption","label":"Primary photo caption","default":"TAYMAR SPENCER / RIZO FOUNDER"},
    {"type":"richtext","id":"bio","label":"Founder bio","default":"<p>Rizo began without a blueprint, deep resources, or a clear path. Taymar Spencer learned through the work—designing and making the clothes himself, accepting help, and turning every limitation into part of the language.</p><p>What began as one person’s outlet became a way to give other people room to express themselves. Rizo exists to give creativity somewhere to live—and to prove that being placed in a box does not mean staying there.</p>"},
    {"type":"checkbox","id":"show_origin_marks","label":"Show the original sketch and logo evolution","default":true},
    {"type":"text","id":"link_label","label":"Optional link label","default":"READ THE FULL ORIGIN"},
    {"type":"url","id":"link","label":"Optional link"}
  ],
  "blocks":[
    {
      "type":"photo",
      "name":"Archive photo",
      "settings":[
        {"type":"image_picker","id":"image","label":"Optional replacement photo"},
        {"type":"select","id":"archive_asset","label":"Built-in Rizo archive image","default":"none","options":[{"value":"none","label":"None"},{"value":"founder_mural","label":"Founder at Pittsburgh mural"},{"value":"founder_full_fit","label":"Founder in full Rizo fit"},{"value":"community_create","label":"Community creative table interaction"},{"value":"community_table","label":"Community art table"},{"value":"stadium","label":"412 outside the stadium"},{"value":"underpass","label":"412 underpass campaign"},{"value":"circle_night","label":"Rizo circle at night"}]},
        {"type":"text","id":"alt","label":"Alt text"},
        {"type":"text","id":"caption","label":"Caption"}
      ]
    },
    {
      "type":"quote",
      "name":"Founder quote",
      "settings":[
        {"type":"textarea","id":"quote","label":"Real founder quote"},
        {"type":"text","id":"attribution","label":"Attribution"}
      ]
    }
  ],
  "presets":[{"name":"Founder signal"}]
}
{% endschema %}
