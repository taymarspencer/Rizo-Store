{% render 'page-head', title: 'Collections', crumbs: true, fog: 0.4 %}
<section class="s" data-surface="solid" data-space="s" data-fog="0" data-rizo-event-quiet>
  <div class="wrap wrap--wide coll-list">
    {%- for collection in collections -%}
      <a class="coll-tile" href="{{ collection.url }}">
        <span class="coll-tile-media">
          {%- assign tile_image = collection.featured_image | default: collection.products.first.featured_image -%}
          {%- if tile_image -%}{{ tile_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 750px) 33vw, 100vw', alt: '' }}{%- else -%}<span class="placeholder-media">{% render 'rizo-mark' %}</span>{%- endif -%}
        </span>
        <strong>{{ collection.title }}</strong>
        <span>{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}{ "name": "Collections list", "settings": [] }{% endschema %}
