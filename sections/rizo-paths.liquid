<section class="paths page-width" id="RizoWorldHub">
  <header class="section-heading paths-heading">
    <div>
      {% if section.settings.show_dateline %}{% render 'rizo-dateline', label: section.settings.dateline_label %}{% endif %}
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.text != blank %}<p class="section-intro">{{ section.settings.text }}</p>{% endif %}
    </div>
    <div class="paths-heading-art" aria-hidden="true">
      <img src="{{ 'rizo-face-white.png' | asset_url }}" width="317" height="360" loading="lazy" alt="">
    </div>
  </header>

  <div class="path-grid path-grid--world">
    {% for block in section.blocks %}
      {% capture fallback_art %}
        <div class="path-card-fallback path-card-fallback--{{ block.settings.art_style | default: 'classic' }}" aria-hidden="true">
          <span>0{{ forloop.index }} / {{ block.settings.kicker }}</span>
          {% case block.settings.art_style %}
            {% when 'logo-white' %}
              <img src="{{ 'rizo-logo-white.webp' | asset_url }}" width="1393" height="1600" alt="" loading="lazy">
            {% when 'face-blue' %}
              <img src="{{ 'rizo-face-variant-blue.png' | asset_url }}" width="533" height="680" alt="" loading="lazy">
            {% when 'face-white' %}
              <img src="{{ 'rizo-face-white.png' | asset_url }}" width="317" height="360" alt="" loading="lazy">
            {% when 'camo' %}
              <img src="{{ 'rizo-world-camo.webp' | asset_url }}" width="2400" height="1200" alt="" loading="lazy">
            {% when '412' %}
              <img src="{{ 'rizo-412-mark.webp' | asset_url }}" width="768" height="768" alt="" loading="lazy">
            {% else %}
              <img src="{{ 'rizo-face-basic.png' | asset_url }}" width="800" height="800" alt="" loading="lazy">
          {% endcase %}
        </div>
      {% endcapture %}

      {% capture path_content %}
        {% if block.settings.image != blank %}
          <div class="path-card-media">
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,700,1000,1200', sizes: '(min-width:900px) 25vw,100vw', alt: block.settings.title }}
          </div>
        {% else %}
          {{ fallback_art }}
        {% endif %}
        <div class="path-card-copy">
          {% if block.settings.kicker != blank %}<span>{{ block.settings.kicker }}</span>{% endif %}
          <h3>{{ block.settings.title }}</h3>
          {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
          {% if block.settings.link != blank and block.settings.link_label != blank %}<b>{{ block.settings.link_label }} {% render 'icon', name: 'arrow' %}</b>{% endif %}
        </div>
      {% endcapture %}

      {% if block.settings.link != blank %}
        <a class="path-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          {{ path_content }}
        </a>
      {% else %}
        <article class="path-card path-card--static" {{ block.shopify_attributes }}>
          {{ path_content }}
        </article>
      {% endif %}
    {% endfor %}
  </div>

  {% if section.settings.show_signal_guide and section.blocks.size > 0 %}
    <div class="signal-guide" data-signal-guide>
      <div class="signal-guide-intro">
        {% if section.settings.guide_eyebrow != blank %}<p class="eyebrow">{{ section.settings.guide_eyebrow }}</p>{% endif %}
        {% if section.settings.guide_heading != blank %}<h3>{{ section.settings.guide_heading }}</h3>{% endif %}
        {% if section.settings.guide_text != blank %}<p>{{ section.settings.guide_text }}</p>{% endif %}
      </div>

      <div class="signal-guide-controls" role="list" aria-label="Choose a Rizo direction">
        {% for block in section.blocks %}
          <button
            class="signal-guide-chip{% if forloop.first %} is-active{% endif %}"
            type="button"
            role="listitem"
            data-signal-choice
            data-guide-kicker="{{ block.settings.kicker | escape }}"
            data-guide-title="{{ block.settings.title | escape }}"
            data-guide-text="{{ block.settings.signal_message | default: block.settings.text | escape }}"
            data-guide-link="{{ block.settings.link }}"
            data-guide-link-label="{{ block.settings.link_label | default: 'OPEN THIS PATH' | escape }}"
            data-guide-share="{{ block.settings.share_message | default: block.settings.title | append: ' / ' | append: block.settings.text | escape }}">
            <span>{{ block.settings.kicker }}</span>
            <strong>{{ block.settings.title }}</strong>
          </button>
        {% endfor %}
      </div>

      {% assign first_block = section.blocks.first %}
      <div class="signal-guide-output" data-signal-guide-output aria-live="polite">
        <p class="signal-guide-kicker">{{ first_block.settings.kicker | default: 'RIZO SIGNAL' }}</p>
        <h4>{{ first_block.settings.title | default: section.settings.guide_heading }}</h4>
        <p>{{ first_block.settings.signal_message | default: first_block.settings.text | default: section.settings.guide_text }}</p>
      </div>

      <div class="signal-guide-actions">
        {% if first_block.settings.link != blank %}
          <a class="button button-ghost" href="{{ first_block.settings.link }}" data-signal-guide-link>{{ first_block.settings.link_label | default: 'OPEN THIS PATH' }}</a>
        {% else %}
          <a class="button button-ghost" href="{{ routes.root_url }}#RizoLiveShop" data-signal-guide-link hidden>OPEN THIS PATH</a>
        {% endif %}
        <button class="button button-hot" type="button" data-signal-guide-copy>{{ section.settings.guide_copy_label }}</button>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name":"Choose a path",
  "max_blocks":4,
  "settings":[
    {"type":"checkbox","id":"show_dateline","label":"Show world fileline","default":true},
    {"type":"text","id":"dateline_label","label":"Fileline label","default":"RIZO WORLD / OPEN A PATH"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"OPEN THE WORLD"},
    {"type":"text","id":"heading","label":"Heading","default":"THE SHOP IS THE FRONT DOOR. NOT THE WHOLE BUILDING."},
    {"type":"textarea","id":"text","label":"Intro text","default":"Rizo should feel like a place, not just a product grid. Pick a path and the world answers back with the right direction."},
    {"type":"checkbox","id":"show_signal_guide","label":"Show interactive signal guide","default":true},
    {"type":"text","id":"guide_eyebrow","label":"Guide eyebrow","default":"SIGNAL GUIDE"},
    {"type":"text","id":"guide_heading","label":"Guide heading","default":"WHAT PART OF THE WORLD DO YOU NEED RIGHT NOW?"},
    {"type":"textarea","id":"guide_text","label":"Guide intro text","default":"Tap a direction and the guide returns a Rizo signal you can follow—or copy and share."},
    {"type":"text","id":"guide_copy_label","label":"Copy button label","default":"COPY SIGNAL"}
  ],
  "blocks":[
    {
      "type":"path",
      "name":"World path",
      "settings":[
        {"type":"image_picker","id":"image","label":"Optional image override"},
        {"type":"select","id":"art_style","label":"Fallback art style","default":"classic","options":[{"value":"classic","label":"Classic face"},{"value":"logo-white","label":"White logo"},{"value":"face-blue","label":"Blue face variant"},{"value":"face-white","label":"White face"},{"value":"camo","label":"Rizo world camo"},{"value":"412","label":"412 mark"}]},
        {"type":"text","id":"kicker","label":"Kicker","default":"ENTER"},
        {"type":"text","id":"title","label":"Title","default":"SHOP THE CURRENT SIGNAL"},
        {"type":"textarea","id":"text","label":"Text","default":"The pieces available now, with fit and release details attached."},
        {"type":"text","id":"link_label","label":"Link label","default":"OPEN"},
        {"type":"url","id":"link","label":"Destination"},
        {"type":"textarea","id":"signal_message","label":"Signal guide response","default":"Start with the pieces that are live now. The clothing is still the fastest way into the world."},
        {"type":"textarea","id":"share_message","label":"Copyable signal message","default":"RIZO SIGNAL / I entered through the live pieces."}
      ]
    }
  ],
  "presets":[
    {
      "name":"Choose a path",
      "blocks":[
        {"type":"path"},
        {"type":"path","settings":{"kicker":"STORY","title":"READ THE ORIGIN","art_style":"logo-white"}},
        {"type":"path","settings":{"kicker":"WORLD","title":"OPEN THE ARCHIVE","art_style":"camo"}},
        {"type":"path","settings":{"kicker":"OUTSIDE","title":"FIND THE CIRCLE","art_style":"412"}}
      ]
    }
  ]
}
{% endschema %}
