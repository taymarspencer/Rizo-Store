{%- capture search_title -%}{% if search.performed %}“{{ search.terms | escape }}”{% else %}Search{% endif %}{%- endcapture -%}
{% render 'page-head', title: search_title, crumbs: false, fog: 0.4 %}
<section class="s" data-surface="solid" data-space="s" data-fog="0" data-rizo-event-quiet>
  <div class="wrap wrap--wide">
    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search" style="margin-bottom: 32px">
      <label class="visually-hidden" for="SearchPageInput">Search</label>
      <input class="input" id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Hoodie, gold, 412…">
      <input type="hidden" name="type" value="product,page,collection,article">
      <button class="btn btn--solid" type="submit">Search</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <div class="search-meta"><p>{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}</p><a href="{{ routes.search_url }}">Clear</a></div>
        {%- if search.results_count > 0 -%}
          <div class="search-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item, show_quick_add: true %}
              {%- else -%}
                <article class="search-doc"><p class="v-label">{{ item.object_type }}</p><h2><a href="{{ item.url }}">{{ item.title }}</a></h2><p>{{ item.content | strip_html | truncatewords: 26 }}</p></article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="empty"><h2>Nothing by that name.</h2><p>Try one word, a colour, or the name on the tag.</p><a class="btn btn--line" href="{{ routes.all_products_collection_url }}">See everything</a></div>
        {%- endif -%}
        {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pages">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="search-shortcuts"><a href="{{ routes.all_products_collection_url }}">Everything {% render 'icon', name: 'arrow' %}</a><a href="{{ routes.collections_url }}">Collections {% render 'icon', name: 'arrow' %}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}{ "name": "Search", "settings": [] }{% endschema %}
