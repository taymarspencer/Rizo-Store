{% liquid
  assign first_block = section.blocks.first
  assign first_art = 'rizo-logo.png'
  if first_block != blank
    case first_block.settings.art
      when 'logo'
        assign first_art = 'rizo-logo-white.webp'
      when 'face-white'
        assign first_art = 'rizo-secondary-face.png'
      when '412'
        assign first_art = 'rizo-412-mark.webp'
      when 'face-blue'
        assign first_art = 'rizo-face-variant-blue.png'
      when 'classic'
        assign first_art = 'rizo-logo.png'
    endcase
  endif
%}
<section class="world-map page-width" id="RizoWorldMap" data-world-map>
  <header class="world-map-heading">
    <div>
      {% if section.settings.show_dateline %}{% render 'rizo-dateline', label: section.settings.dateline_label %}{% endif %}
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>
  </header>

  <div class="world-map-interface" data-world-reactive>
    <div class="world-map-stage">
      <div class="world-map-radar" aria-hidden="true">
        <i></i><i></i><i></i><i></i>
      </div>
      <div class="world-map-core" aria-hidden="true">
        <span class="world-map-core-halo"></span>
        <img src="{{ first_art | asset_url }}" width="900" height="900" loading="lazy" alt="" data-world-map-art>
        <b>RIZO</b>
      </div>

      <div class="world-map-nodes" role="group" aria-label="Rizo world zones">
        {% for block in section.blocks %}
          {% liquid
            assign art_asset = 'rizo-logo.png'
            case block.settings.art
              when 'logo'
                assign art_asset = 'rizo-logo-white.webp'
              when 'face-white'
                assign art_asset = 'rizo-secondary-face.png'
              when '412'
                assign art_asset = 'rizo-412-mark.webp'
              when 'face-blue'
                assign art_asset = 'rizo-face-variant-blue.png'
              when 'classic'
                assign art_asset = 'rizo-logo.png'
            endcase
          %}
          <button
            class="world-map-node world-map-node--{{ forloop.index }}{% if forloop.first %} is-active{% endif %}"
            type="button"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            data-world-node
            data-world-id="{{ block.settings.zone_id | default: block.settings.kicker | handleize }}"
            data-world-kicker="{{ block.settings.kicker | escape }}"
            data-world-title="{{ block.settings.title | escape }}"
            data-world-text="{{ block.settings.text | escape }}"
            data-world-link="{{ block.settings.link }}"
            data-world-link-label="{{ block.settings.link_label | escape }}"
            data-world-art="{{ art_asset | asset_url }}"
            {{ block.shopify_attributes }}>
            <span>0{{ forloop.index }}</span>
            <strong>{{ block.settings.kicker }}</strong>
            <small>{{ block.settings.short_label }}</small>
          </button>
        {% endfor %}
      </div>
    </div>

    <aside class="world-map-panel">
      <div class="world-map-panel-status">
        <span data-world-map-kicker>{{ first_block.settings.kicker | default: 'WORLD ZONE' }}</span>
        <b>ACTIVE FILE</b>
      </div>
      <h3 data-world-map-title>{{ first_block.settings.title | default: section.settings.heading }}</h3>
      <p data-world-map-text>{{ first_block.settings.text | default: section.settings.text }}</p>
      <span class="visually-hidden" data-world-map-live aria-live="polite"></span>
      <a class="button button-hot" href="{{ first_block.settings.link | default: routes.all_products_collection_url }}" data-world-map-link><span data-world-map-link-label>{{ first_block.settings.link_label | default: 'ENTER ZONE' }}</span> {% render 'icon', name: 'arrow' %}</a>

      <div class="world-passport" data-world-passport>
        <div class="world-passport-heading">
          <span>WORLD PASSPORT</span>
          <strong data-world-passport-count>0 / {{ section.blocks.size }}</strong>
        </div>
        <div class="world-passport-stamps" role="list" aria-label="Recovered world zones">
          {% for block in section.blocks %}
            <span role="listitem" data-world-stamp="{{ block.settings.zone_id | default: block.settings.kicker | handleize }}" title="{{ block.settings.kicker | escape }}">0{{ forloop.index }}</span>
          {% endfor %}
        </div>
        <p data-world-passport-message>Recover each zone. Your progress stays on this device.</p>
        {% if section.settings.show_passport_reward %}
          <div class="world-passport-reward" data-world-passport-reward hidden>
            <img src="{{ 'rizo-world-passport-wallpaper.webp' | asset_url }}" width="1440" height="2560" loading="lazy" alt="Rizo World camo phone wallpaper preview">
            <div>
              <strong>{{ section.settings.reward_heading }}</strong>
              <p>{{ section.settings.reward_text }}</p>
              <div class="world-passport-actions">
                <a class="button button-ghost" href="{{ 'rizo-world-passport-wallpaper.webp' | asset_url }}" target="_blank" rel="noopener" data-analytics="passport_reward_previewed">{{ section.settings.reward_label }}<span class="visually-hidden"> (opens in a new tab)</span></a>
                <a class="text-link" href="{{ 'rizo-world-passport-wallpaper.webp' | asset_url }}" download data-analytics="passport_reward_downloaded">SAVE FILE</a>
              </div>
            </div>
          </div>
        {% endif %}
        <details class="world-passport-tools">
          <summary>PASSPORT OPTIONS</summary>
          <button type="button" class="world-passport-reset" data-world-passport-reset>RESET PASSPORT</button>
        </details>
      </div>
    </aside>
  </div>
</section>

{% schema %}
{
  "name":"Rizo world map",
  "tag":"section",
  "class":"section-world-map",
  "max_blocks":4,
  "settings":[
    {"type":"checkbox","id":"show_dateline","label":"Show map fileline","default":true},
    {"type":"text","id":"dateline_label","label":"Fileline label","default":"WORLD MAP / FOUR ACTIVE ZONES"},
    {"type":"text","id":"eyebrow","label":"Optional eyebrow"},
    {"type":"text","id":"heading","label":"Heading","default":"EVERY SIGNAL OPENS ANOTHER DOOR."},
    {"type":"textarea","id":"text","label":"Intro text","default":"Choose a zone. The map opens its path and remembers where you have been."},
    {"type":"checkbox","id":"show_passport_reward","label":"Reveal wallpaper when every zone is recovered","default":true},
    {"type":"text","id":"reward_heading","label":"Passport reward heading","default":"WORLD RECOVERED"},
    {"type":"textarea","id":"reward_text","label":"Passport reward text","default":"The full passport unlocks a Rizo camo phone wallpaper to carry outside."},
    {"type":"text","id":"reward_label","label":"Passport reward button","default":"PREVIEW WALLPAPER"}
  ],
  "blocks":[
    {
      "type":"zone",
      "name":"World zone",
      "settings":[
        {"type":"text","id":"zone_id","label":"Stable zone ID","info":"Use lowercase letters only, such as shop or origin.","default":"shop"},
        {"type":"text","id":"kicker","label":"Kicker","default":"SHOP"},
        {"type":"text","id":"short_label","label":"Short orbit label","default":"LIVE PIECES"},
        {"type":"text","id":"title","label":"Title","default":"SHOP WHAT IS LIVE"},
        {"type":"textarea","id":"text","label":"Description","default":"Current pieces, honest stock, fit information, and the fastest entrance into the world."},
        {"type":"text","id":"link_label","label":"Link label","default":"ENTER ZONE"},
        {"type":"url","id":"link","label":"Destination"},
        {"type":"select","id":"art","label":"Center art","default":"face-blue","options":[{"value":"face-blue","label":"Blue face variant"},{"value":"logo","label":"One-color Rizo logo"},{"value":"face-white","label":"Secondary face mark"},{"value":"412","label":"412 mark"},{"value":"classic","label":"Primary full-color Rizo logo"}]}
      ]
    }
  ],
  "presets":[
    {
      "name":"Rizo world map",
      "blocks":[
        {"type":"zone","settings":{"zone_id":"shop","kicker":"SHOP","short_label":"LIVE PIECES","title":"SHOP WHAT IS LIVE","link_label":"ENTER THE SHOP","art":"face-blue"}},
        {"type":"zone","settings":{"zone_id":"origin","kicker":"ORIGIN","short_label":"FIRST FILE","title":"READ THE ORIGIN","link_label":"OPEN ORIGIN FILE","art":"logo"}},
        {"type":"zone","settings":{"zone_id":"signal","kicker":"SIGNAL","short_label":"MAKE YOURS","title":"FORGE A SIGNAL","link_label":"OPEN SIGNAL FORGE","art":"face-white"}},
        {"type":"zone","settings":{"zone_id":"circle","kicker":"CIRCLE","short_label":"REAL PEOPLE","title":"FIND THE CIRCLE","link_label":"MEET THE CIRCLE","art":"412"}}
      ]
    }
  ]
}
{% endschema %}
