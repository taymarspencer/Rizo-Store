{% liquid
  assign valid_people = 0
  for block in section.blocks
    if block.settings.image != blank and block.settings.name != blank
      assign valid_people = valid_people | plus: 1
    endif
  endfor
  assign mode = section.settings.mode | default: 'circle'
%}

{% if mode == 'official' and valid_people > 0 %}
  <section class="team-section page-width" id="RizoCircle">
    {% if settings.heritage_mode %}{% render 'rizo-dateline', label: section.settings.dateline_label %}{% endif %}
    <header class="section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.text != blank %}<div class="rte section-intro">{{ section.settings.text }}</div>{% endif %}
      </div>
    </header>

    <div class="team-grid">
      {% for block in section.blocks %}
        {% if block.settings.image != blank and block.settings.name != blank %}
          <article class="team-card" {{ block.shopify_attributes }}>
            <div class="team-photo">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', sizes: '(min-width: 900px) 33vw, 90vw', alt: block.settings.image.alt | default: block.settings.name }}
            </div>
            <div class="team-copy">
              <h3>{{ block.settings.name }}</h3>
              {% if block.settings.role != blank %}<span>{{ block.settings.role }}</span>{% endif %}
              {% if block.settings.bio != blank %}<p>{{ block.settings.bio }}</p>{% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% elsif mode == 'circle' %}
  {% render 'rizo-circle-content', id: 'RizoCircle', style: section.settings.display_style, dateline_label: section.settings.dateline_label, eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, shoutout: section.settings.shoutout %}
{% elsif request.design_mode %}
  <section class="team-section page-width" aria-label="Team section setup">
    <div class="editor-setup-state">
      <strong>OFFICIAL TEAM MODE IS HIDDEN</strong>
      <p>Add a real photo and name to at least one official team-member block, or switch the section back to Rizo Circle mode.</p>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name":"Rizo circle",
  "class":"section-rizo-team",
  "max_blocks":8,
  "settings":[
    {"type":"select","id":"mode","label":"Section mode","default":"circle","options":[{"value":"circle","label":"Rizo Circle — no formal titles"},{"value":"official","label":"Official named team"}]},
    {"type":"select","id":"display_style","label":"Circle layout","default":"full","options":[{"value":"full","label":"Full page"},{"value":"compact","label":"Compact homepage"}]},
    {"type":"text","id":"dateline_label","label":"Fileline label","default":"RIZO PEOPLE / THE CIRCLE"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE RIZO CIRCLE"},
    {"type":"text","id":"heading","label":"Heading","default":"ONE VISION. MANY HANDS ALONG THE WAY."},
    {"type":"richtext","id":"text","label":"Introduction","default":"<p>Rizo is founder-led. Taymar designs and makes the pieces, but the world has never moved alone. Friends, models, event help, supporters and people who believed early have helped carry it outside.</p><p>No inflated titles. No pretending a growing circle is a corporate team. Just real people showing up while the world takes shape.</p>"},
    {"type":"textarea","id":"shoutout","label":"Circle shoutout","default":"SHOUT OUT TO EVERY PERSON WHO MODELED, HELPED AT A TABLE, CARRIED PIECES, TOOK A PHOTO, GAVE FEEDBACK, OR SHOWED UP BEFORE THERE WAS A TITLE FOR IT."}
  ],
  "blocks":[
    {
      "type":"person",
      "name":"Official team member",
      "settings":[
        {"type":"image_picker","id":"image","label":"Real photo"},
        {"type":"text","id":"name","label":"Name"},
        {"type":"text","id":"role","label":"Confirmed role"},
        {"type":"textarea","id":"bio","label":"Short factual bio"}
      ]
    }
  ],
  "presets":[{"name":"Rizo circle"}]
}
{% endschema %}
