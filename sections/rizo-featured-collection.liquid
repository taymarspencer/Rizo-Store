<section class="collection-zone page-width" data-section-id="{{ section.id }}">
  <header class="section-heading">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p class="section-intro">{{ section.settings.text }}</p>{% endif %}
    </div>
    {% if section.settings.collection != blank %}
      <a class="text-arrow section-link" href="{{ section.settings.collection.url }}">VIEW THE FULL SIGNAL {% render 'icon', name: 'arrow' %}</a>
    {% endif %}
  </header>

  <div class="product-grid product-grid--scroll" data-product-track>
    {% if section.settings.collection != blank %}
      {% for product in section.settings.collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add, show_vendor: section.settings.show_vendor %}
      {% else %}
        <div class="empty-state"><img src="{{ 'rizo-face-white.png' | asset_url }}" width="317" height="360" alt="" loading="lazy"><h3>This collection is between signals.</h3><p>Open the live shop or join the signal for the next release.</p><div class="empty-state-actions"><a class="button button-hot" href="{{ routes.all_products_collection_url }}">SHOP WHAT IS LIVE</a><a class="button button-ghost" href="{{ routes.root_url }}#RizoSignal">GET THE SIGNAL</a></div></div>
      {% endfor %}
    {% else %}
      {% if request.design_mode %}<div class="editor-setup-state">Choose a collection before publishing this section.</div>{% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name":"Featured collection",
  "class":"section-featured-collection",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHAT’S LIVE"},
    {"type":"text","id":"heading","label":"Heading","default":"THE CURRENT SIGNAL, READY TO WEAR"},
    {"type":"textarea","id":"text","label":"Supporting text","default":"Live stock, small runs, and the pieces available right now."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Products","min":2,"max":8,"step":1,"default":4},
    {"type":"checkbox","id":"show_quick_add","label":"Show quick add","default":true},
    {"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false}
  ],
  "presets":[{"name":"Featured collection"}]
}
{% endschema %}
