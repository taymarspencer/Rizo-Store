{% if page.handle == 'contact' or page.handle == 'contact-us' %}
  {% assign contact_form_id = 'RizoContactForm-' | append: section.id %}
  <section class="contact-page page-width">
    {% render 'rizo-contact-form', form_id: contact_form_id %}
  </section>
{% elsif page.handle == 'circle' or page.handle == 'crew' or page.handle == 'team' or page.handle == 'rizo-circle' %}
  {% render 'rizo-circle-content', id: 'RizoCircle', style: 'full' %}
{% else %}
  <section class="standard-page standard-page--{{ section.settings.width }} page-width">
    {% if settings.heritage_mode %}{% render 'rizo-dateline', label: 'RIZO PAGE / STORY FILE' %}{% endif %}
    <div class="section-mark-line">{% render 'rizo-brand-stamp', variant: 'face', class: 'section-secondary-mark standard-page-secondary-mark' %}<p class="eyebrow">{{ section.settings.eyebrow }}</p></div>
    <h1>{{ page.title }}</h1>
    <div class="rte page-content">{{ page.content }}</div>
  </section>
{% endif %}
{% schema %}
{"name":"Main page","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"RIZO WORLD"},{"type":"select","id":"width","label":"Content width","default":"narrow","options":[{"value":"narrow","label":"Narrow"},{"value":"wide","label":"Wide"}]}]}
{% endschema %}
