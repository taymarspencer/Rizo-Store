{%- comment -%}
  Any page made in Shopify admin (FAQ, shipping, sizing, a new story…)
  gets the route header and a readable column automatically.
{%- endcomment -%}
{% render 'page-head', title: page.title, label: section.settings.label, align: section.settings.align, fog: 0.5 %}
{%- if page.content != blank -%}
  <section class="s" data-surface="solid" data-space="m" data-fog="0">
    <div class="page-body">
      <div class="rte t-lead">{{ page.content }}</div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label above the title" },
    { "type": "select", "id": "align", "label": "Title position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "offset", "label": "Pushed in" }, { "value": "right", "label": "Right" }] }
  ]
}
{% endschema %}
