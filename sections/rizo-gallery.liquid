{{ 'rizo-worlds.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Real photographs, laid out with unequal weight. "Spread" places them on
  a 12-column grid in a fixed, considered rhythm (no random offsets).
{%- endcomment -%}
<section class="s" data-surface="{{ section.settings.surface }}" data-space="{{ section.settings.space }}" data-fog="{{ section.settings.fog | divided_by: 100.0 }}" id="{{ section.settings.anchor | default: section.id | handle }}">
  {% render 'rizo-art', section: section %}
  <div class="wrap wrap--wide">
    {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.label != blank -%}
      <div class="gallery-head">
        <div>
          {%- if section.settings.label != blank -%}<p class="v-label muted">{{ section.settings.label | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="gallery gallery--{{ section.settings.layout }}">
      {%- assign photos = section.blocks | where: 'type', 'photo' -%}
      {%- for block in photos -%}
        <figure class="gallery-item{% if block.settings.full_frame %} gallery-item--full{% endif %}" {{ block.shopify_attributes }}>
          {% render 'rizo-image', image: block.settings.image, mobile_image: block.settings.image_mobile, builtin: block.settings.builtin_image, sizes: '(min-width: 750px) 60vw, 100vw', alt: block.settings.alt, enlarge: section.settings.open_photos %}
          {%- if block.settings.caption != blank or block.settings.caption_right != blank -%}
            <figcaption class="gallery-cap"><span>{{ block.settings.caption | escape }}</span><span>{{ block.settings.caption_right | escape }}</span></figcaption>
          {%- endif -%}
          {%- if block.settings.person != blank or block.settings.place != blank or block.settings.year != blank or block.settings.piece != blank or block.settings.credit != blank -%}
            <div class="archive-meta">
              {%- if block.settings.person != blank -%}<strong>{{ block.settings.person | escape }}</strong>{%- endif -%}
              {%- if block.settings.place != blank -%}<span>{{ block.settings.place | escape }}</span>{%- endif -%}
              {%- if block.settings.piece != blank or block.settings.year != blank -%}<span>{{ block.settings.piece | escape }}{% if block.settings.piece != blank and block.settings.year != blank %} · {% endif %}{{ block.settings.year | escape }}</span>{%- endif -%}
              {%- if block.settings.credit != blank -%}{% if block.settings.credit_link != blank %}<a href="{{ block.settings.credit_link }}">{{ block.settings.credit | escape }}</a>{% else %}<span>{{ block.settings.credit | escape }}</span>{% endif %}{%- endif -%}
            </div>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <div class="gallery-foot"><a class="link" href="{{ section.settings.link | default: '/pages/circle' }}"><span>{{ section.settings.link_label | escape }}</span>{% render 'icon', name: 'arrow' %}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
