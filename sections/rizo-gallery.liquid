{%- comment -%}
  Real photographs, laid out with unequal weight. "Spread" places them on
  a 12-column grid in a fixed, considered rhythm (no random offsets).
{%- endcomment -%}
<section class="s" data-surface="{{ section.settings.surface }}" data-space="{{ section.settings.space }}" data-fog="{{ section.settings.fog | divided_by: 100.0 }}" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="wrap wrap--wide">
    {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.label != blank -%}
      <div class="gallery-head">
        <div>
          {%- if section.settings.label != blank -%}<p class="v-label muted">{{ section.settings.label | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="gallery gallery--{{ section.settings.layout }}">
      {%- for block in section.blocks -%}
        <figure class="gallery-item" {{ block.shopify_attributes }}>
          {% render 'rizo-image', image: block.settings.image, builtin: block.settings.builtin_image, sizes: '(min-width: 750px) 50vw, 100vw', alt: block.settings.alt %}
          {%- if block.settings.caption != blank or block.settings.caption_right != blank -%}
            <figcaption class="gallery-cap"><span>{{ block.settings.caption | escape }}</span><span>{{ block.settings.caption_right | escape }}</span></figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    {%- if section.settings.link_label != blank -%}
      <div class="gallery-foot"><a class="link" href="{{ section.settings.link | default: '/pages/circle' }}"><span>{{ section.settings.link_label | escape }}</span>{% render 'icon', name: 'arrow' %}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Photographs",
  "tag": "div",
  "class": "section-gallery",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "spread", "options": [{ "value": "spread", "label": "Spread (unequal)" }, { "value": "strip", "label": "Strip (equal)" }] },
    { "type": "text", "id": "link_label", "label": "Link" },
    { "type": "url", "id": "link", "label": "Link destination" },
    { "type": "text", "id": "anchor", "label": "Anchor", "info": "Lets other links jump here, e.g. circle for /#circle." },
    { "type": "select", "id": "surface", "label": "Surface", "default": "solid", "options": [{ "value": "solid", "label": "Solid" }, { "value": "raised", "label": "Raised" }, { "value": "open", "label": "Open sky" }] },
    { "type": "select", "id": "space", "label": "Space", "default": "l", "options": [{ "value": "s", "label": "Tight" }, { "value": "m", "label": "Normal" }, { "value": "l", "label": "Loose" }] },
    { "type": "range", "id": "fog", "label": "Fog", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "select", "id": "builtin_image", "label": "Photo when none is uploaded", "default": "underpass", "options": [
          { "value": "underpass", "label": "Underpass" }, { "value": "circle_night", "label": "Friends at night" },
          { "value": "stadium", "label": "Stadium at night" }, { "value": "circle_gym", "label": "Gym" },
          { "value": "circle_pink", "label": "Pink hoodie" }, { "value": "table", "label": "Event table" },
          { "value": "making", "label": "Making" }, { "value": "founder", "label": "Taymar, full fit" },
          { "value": "founder_mural", "label": "Taymar at the mural" }, { "value": "none", "label": "None" }
        ] },
        { "type": "text", "id": "alt", "label": "Description" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "caption_right", "label": "Caption, right side" }
      ]
    }
  ],
  "presets": [{ "name": "Photographs", "blocks": [{ "type": "photo" }, { "type": "photo", "settings": { "builtin_image": "circle_night" } }] }]
}
{% endschema %}
