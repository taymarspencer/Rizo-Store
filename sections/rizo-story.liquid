{%- comment -%}
  A photograph and a few sentences. Optionally, a drawing tucked behind
  the photo that can be pulled out (native <details>, no script needed).
{%- endcomment -%}
<section class="s" data-surface="{{ section.settings.surface }}" data-space="{{ section.settings.space }}" data-fog="{{ section.settings.fog | divided_by: 100.0 }}">
  {% render 'rizo-art', section: section %}
  <div class="wrap story" data-flip="{{ section.settings.flip }}">
    <div class="story-media">
      <figure class="story-photo">
        {% render 'rizo-image', image: section.settings.image, mobile_image: section.settings.image_mobile, mobile_sizes: '82vw', builtin: section.settings.builtin_image, sizes: '(min-width: 750px) 40vw, 82vw', alt: section.settings.image_alt %}
        {%- if section.settings.caption != blank -%}<figcaption>{{ section.settings.caption | escape }}</figcaption>{%- endif -%}
      </figure>
      {%- if section.settings.show_pocket -%}
        <details class="pocket">
          <summary>
            <span class="pocket-sheet">{% render 'rizo-image', image: section.settings.pocket_image, builtin: 'sketch', sizes: '(min-width: 750px) 36vw, 70vw', alt: section.settings.pocket_alt %}</span>
            <span class="pocket-tab">{{ section.settings.pocket_label | escape }}</span>
          </summary>
          {%- if section.settings.pocket_note != blank -%}<p class="pocket-note">{{ section.settings.pocket_note | escape }}</p>{%- endif -%}
        </details>
      {%- endif -%}
    </div>
    <div class="story-copy">
      {%- if section.settings.label != blank -%}<p class="v-label muted">{{ section.settings.label | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="story-body">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="link" href="{{ section.settings.link | default: '/pages/about' }}"><span>{{ section.settings.link_label | escape }}</span>{% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "tag": "div",
  "class": "section-story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "image_picker", "id": "image_mobile", "label": "Photo on phones", "info": "Optional: a different crop or photo under 750px wide. Crops follow each image's focal point." },
    { "type": "select", "id": "builtin_image", "label": "Photo when none is uploaded", "default": "founder", "options": [
      { "value": "founder", "label": "Taymar, full fit" }, { "value": "founder_mural", "label": "Taymar at the mural" },
      { "value": "underpass", "label": "Underpass" }, { "value": "stadium", "label": "Stadium at night" },
      { "value": "circle_night", "label": "Friends at night" }, { "value": "circle_gym", "label": "Gym" },
      { "value": "circle_pink", "label": "Pink hoodie" }, { "value": "table", "label": "Event table" },
      { "value": "making", "label": "Making" }, { "value": "none", "label": "None" }
    ] },
    { "type": "text", "id": "image_alt", "label": "Photo description", "default": "Taymar Spencer in a black Rizo outfit" },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "text", "id": "label", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Taymar Spencer" },
    { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Rizo started with one person drawing, pressing and figuring it out in Pittsburgh.</p>" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "How it started" },
    { "type": "url", "id": "link", "label": "Link destination" },
    { "type": "checkbox", "id": "flip", "label": "Photo on the right", "default": false },
    { "type": "header", "content": "Tucked-in drawing" },
    { "type": "checkbox", "id": "show_pocket", "label": "Tuck a drawing behind the photo", "default": true },
    { "type": "image_picker", "id": "pocket_image", "label": "Drawing", "info": "Defaults to the first Rizo drawing." },
    { "type": "text", "id": "pocket_label", "label": "Label on the corner", "default": "First drawing" },
    { "type": "text", "id": "pocket_alt", "label": "Drawing description", "default": "Pencil sketch of the first Rizo flame face" },
    { "type": "text", "id": "pocket_note", "label": "Line when it’s pulled out" },
    { "type": "header", "content": "Surface" },
    { "type": "select", "id": "surface", "label": "Surface", "default": "solid", "options": [{ "value": "solid", "label": "Solid" }, { "value": "raised", "label": "Raised" }, { "value": "open", "label": "Open sky" }] },
    { "type": "select", "id": "space", "label": "Space", "default": "l", "options": [{ "value": "s", "label": "Tight" }, { "value": "m", "label": "Normal" }, { "value": "l", "label": "Loose" }] },
    { "type": "range", "id": "fog", "label": "Fog", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 10 }
  ],
  "blocks": [
    {
      "type": "art",
      "name": "Art",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Artwork", "info": "Transparent PNG or WebP works best. Later blocks sit on top of earlier ones." },
        { "type": "image_picker", "id": "image_mobile", "label": "Phone version", "info": "Optional: a different crop, or a different piece, for phones." },
        { "type": "header", "content": "Placement" },
        { "type": "range", "id": "x", "label": "Across", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 80, "info": "Where the centre of the piece sits, as a share of the section." },
        { "type": "range", "id": "y", "label": "Down", "min": -20, "max": 120, "step": 2, "unit": "%", "default": 30, "info": "Below 0 or above 100 hangs over the edge of the section." },
        { "type": "range", "id": "size", "label": "Size", "min": 4, "max": 140, "step": 2, "unit": "%", "default": 22, "info": "Width, as a share of the section's width." },
        { "type": "range", "id": "rotate", "label": "Turn", "min": -180, "max": 180, "step": 5, "unit": "°", "default": 0 },
        { "type": "range", "id": "opacity", "label": "Opacity", "min": 5, "max": 100, "step": 5, "unit": "%", "default": 100 },
        { "type": "select", "id": "layer", "label": "Layer", "default": "back", "options": [
          { "value": "back", "label": "Behind the content" },
          { "value": "front", "label": "In front of the content" },
          { "value": "back-front", "label": "Behind on desktop, in front on phones" },
          { "value": "front-back", "label": "In front on desktop, behind on phones" }
        ] },
        { "type": "select", "id": "blend", "label": "Blend", "default": "normal", "options": [
          { "value": "normal", "label": "Normal" },
          { "value": "screen", "label": "Screen (only lightens)" },
          { "value": "multiply", "label": "Multiply (only darkens)" },
          { "value": "overlay", "label": "Overlay" },
          { "value": "soft-light", "label": "Soft light" },
          { "value": "difference", "label": "Difference" },
          { "value": "luminosity", "label": "Luminosity" }
        ] },
        { "type": "header", "content": "Phones" },
        { "type": "select", "id": "show", "label": "Show on", "default": "all", "options": [
          { "value": "all", "label": "Desktop and phones" },
          { "value": "desktop", "label": "Desktop only" },
          { "value": "phone", "label": "Phones only" }
        ] },
        { "type": "range", "id": "mobile_x", "label": "Across on phones", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 80 },
        { "type": "range", "id": "mobile_y", "label": "Down on phones", "min": -20, "max": 120, "step": 2, "unit": "%", "default": 20 },
        { "type": "range", "id": "mobile_size", "label": "Size on phones", "min": 4, "max": 140, "step": 2, "unit": "%", "default": 40 },
        { "type": "header", "content": "Movement" },
        { "type": "select", "id": "motion", "label": "Movement", "default": "none", "options": [
          { "value": "none", "label": "Still" },
          { "value": "float", "label": "Floats" },
          { "value": "sway", "label": "Sways from its top edge" },
          { "value": "depth", "label": "Depth: drifts as the page scrolls" },
          { "value": "settle", "label": "Settles into place when it appears" },
          { "value": "shy", "label": "Moves away from the pointer or finger" },
          { "value": "wobble", "label": "Wobbles when touched" },
          { "value": "spin", "label": "Spins when touched" }
        ] },
        { "type": "range", "id": "strength", "label": "How much", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
        { "type": "select", "id": "when", "label": "When", "default": "always", "options": [
          { "value": "always", "label": "Always" },
          { "value": "event", "label": "Only while a seasonal event is on" },
          { "value": "normal", "label": "Only when no event is on" }
        ] },
        { "type": "text", "id": "name", "label": "Name for custom CSS", "info": "Optional. Adds data-art=\"name\" to the piece." }
      ]
    }
  ],
  "presets": [{ "name": "Story" }]
}
{% endschema %}
