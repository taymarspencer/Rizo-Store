{%- liquid
  assign notice = section.settings.announcement_text | strip
  capture event_message
    render 'rizo-event-value', key: 'announcement'
  endcapture
  assign event_message = event_message | strip
  assign show_notice = false
  if section.settings.show_announcement and notice != blank
    assign show_notice = true
  endif
  if event_message != blank
    assign show_notice = true
  endif
-%}
<header class="header" data-header-stack data-header style="view-transition-name: rizo-header">
  {%- if show_notice -%}
    <a class="notice{% if notice == blank or section.settings.show_announcement == false %} rizo-event-only{% endif %}" href="{{ section.settings.announcement_link | default: routes.all_products_collection_url }}">
      {%- if section.settings.show_announcement and notice != blank -%}
        <span class="notice-copy"{% if event_message != blank %} data-rizo-event-default{% endif %}>{{ notice }}</span>
      {%- endif -%}
      {%- if event_message != blank -%}
        <span class="notice-copy rizo-event-only">{{ event_message }}</span>
      {%- endif -%}
    </a>
  {%- endif -%}

  <div class="header-bar">
    <button class="hdr-btn hdr-menu" type="button" data-overlay-open="menu" aria-label="Open menu" aria-controls="RizoMenu" aria-expanded="false">
      {% render 'icon', name: 'menu' %}
    </button>

    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}, home">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 120 | image_tag: widths: '60,120', sizes: '28px', loading: 'eager', alt: '', class: 'brand-logo' }}
      {%- else -%}
        {% render 'rizo-mark' %}
      {%- endif -%}
      <span class="brand-word" aria-hidden="true">RIZO</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.current or link.child_active %} aria-current="page"{% endif %}>
          {{- link.title -}}
          {%- if link.current or link.child_active %}{% render 'rizo-x', i: forloop.index0, class: 'here' %}{% endif -%}
        </a>
      {%- endfor -%}
    </nav>

    <div class="header-actions">
      {%- if shop.customer_accounts_enabled -%}
        <a class="hdr-btn hdr-search" href="{{ routes.account_url }}">Account</a>
      {%- endif -%}
      <a class="hdr-btn hdr-search" href="{{ routes.search_url }}" data-overlay-open="search" aria-controls="RizoSearch" aria-expanded="false">
        {% render 'icon', name: 'search' %}<span>Search</span>
      </a>
      <a class="hdr-btn hdr-cart" href="{{ routes.cart_url }}" data-overlay-open="cart" aria-label="Open cart with {{ cart.item_count }} items" aria-controls="RizoCart" aria-expanded="false">
        <span class="hdr-label">Cart</span><span class="count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{%- if settings.enable_mobile_shop_utility -%}
  {%- assign shop_link = section.settings.mobile_shop_link | default: routes.all_products_collection_url -%}
  <nav class="dock" aria-label="Quick navigation">
    <a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>
      {% render 'icon', name: 'home' %}<span>Home</span>{% if request.page_type == 'index' %}{% render 'rizo-x', i: 1, class: 'here' %}{% endif %}
    </a>
    <a href="{{ shop_link }}"{% if request.page_type == 'collection' or request.page_type == 'product' %} aria-current="page"{% endif %}>
      {% render 'icon', name: 'shop' %}<span>{{ section.settings.mobile_shop_label | default: 'Shop' }}</span>{% if request.page_type == 'collection' or request.page_type == 'product' %}{% render 'rizo-x', i: 3, class: 'here' %}{% endif %}
    </a>
    <a href="{{ routes.search_url }}" data-overlay-open="search" aria-controls="RizoSearch" aria-expanded="false"{% if request.page_type == 'search' %} aria-current="page"{% endif %}>
      {% render 'icon', name: 'search' %}<span>Search</span>{% if request.page_type == 'search' %}{% render 'rizo-x', i: 2, class: 'here' %}{% endif %}
    </a>
    <a href="{{ routes.cart_url }}" data-overlay-open="cart" aria-label="Open cart with {{ cart.item_count }} items" aria-controls="RizoCart" aria-expanded="false"{% if request.page_type == 'cart' %} aria-current="page"{% endif %}>
      <span class="dock-icon">{% render 'icon', name: 'bag' %}<span class="count" data-cart-count data-count="{{ cart.item_count }}">{{ cart.item_count }}</span></span><span>Cart</span>{% if request.page_type == 'cart' %}{% render 'rizo-x', i: 4, class: 'here' %}{% endif %}
    </a>
  </nav>
{%- endif -%}

<div class="overlay-shell menu" id="RizoMenu" data-overlay="menu" hidden>
  <button class="overlay-backdrop" type="button" data-overlay-close tabindex="-1" aria-hidden="true" aria-label="Close menu"></button>
  <div class="menu-panel" role="dialog" aria-modal="true" aria-label="Menu" tabindex="-1" data-overlay-focus>
    <button class="icon-btn menu-close" type="button" data-overlay-close aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
    <nav class="menu-links" aria-label="Menu">
      <a href="{{ routes.root_url }}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>Home{% if request.page_type == 'index' %}{% render 'rizo-x', i: 0, class: 'here' %}{% endif %}</a>
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.current or link.child_active %} aria-current="page"{% endif %}>
          {{- link.title -}}
          {%- if link.current or link.child_active %}{% render 'rizo-x', i: forloop.index, class: 'here' %}{% endif -%}
        </a>
        {%- if link.links != blank -%}
          <div class="menu-sub">{% for child in link.links %}<a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title }}</a>{% endfor %}</div>
        {%- endif -%}
      {%- endfor -%}
    </nav>
    <div class="menu-more">
      <a href="{{ routes.search_url }}" data-overlay-open="search">Search {% render 'icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">Account {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      {%- if section.settings.instagram_url != blank -%}<a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">Instagram<span class="visually-hidden"> (opens in a new tab)</span> {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    </div>
    <div class="menu-foot"><span>Pittsburgh, PA</span>{% render 'rizo-mark' %}</div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "header", "content": "Announcement" },
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement", "default": false },
    { "type": "text", "id": "announcement_text", "label": "Announcement", "info": "One short line. The event message replaces it while an event is live." },
    { "type": "url", "id": "announcement_link", "label": "Announcement link" },
    { "type": "header", "content": "Phone" },
    { "type": "text", "id": "mobile_shop_label", "label": "Shop label in the bottom bar", "default": "Shop" },
    { "type": "url", "id": "mobile_shop_link", "label": "Shop link in the bottom bar" },
    { "type": "url", "id": "instagram_url", "label": "Instagram link in the menu" }
  ]
}
{% endschema %}
