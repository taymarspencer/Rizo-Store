<!doctype html>
{%- liquid
  assign route = template.name
  if template.suffix != blank
    assign route = template.name | append: '.' | append: template.suffix
  endif

  comment
    A stable per-page number (0-6). Routes use it to vary the sky a little
    so pages feel related without looking copied.
  endcomment
  assign page_seed = 0
  case template.name
    when 'page'
      assign page_seed = page.id | modulo: 7
    when 'product'
      assign page_seed = product.id | modulo: 7
    when 'collection'
      assign page_seed = collection.id | modulo: 7
    when 'article', 'blog'
      assign page_seed = blog.id | modulo: 7
  endcase
-%}
<html class="no-js" lang="{{ request.locale.iso_code }}" data-motion="{{ settings.motion_level | default: 'balanced' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#07090c">
    <meta name="color-scheme" content="dark">
    <meta name="format-detection" content="telephone=no">
    <link rel="canonical" href="{{ canonical_url }}">

    {% if settings.favicon != blank %}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 64, height: 64 }}" type="image/png">
    {% else %}
      <link rel="icon" href="{{ 'favicon.png' | asset_url }}" type="image/png">
    {% endif %}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} · {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} · Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} · {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {{ content_for_header }}

    {{ 'rizo-grotesque.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {{ 'rizo-display.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <style>
      @font-face { font-family: 'Rizo Grotesque'; src: url('{{ 'rizo-grotesque.woff2' | asset_url }}') format('woff2'); font-weight: 200 800; font-stretch: 75% 100%; font-display: swap; }
      @font-face { font-family: 'Rizo Display'; src: url('{{ 'rizo-display.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; }
      :root {
        --night: {{ settings.color_ink }};
        --bone: {{ settings.color_paper }};
        --blue: {{ settings.color_accent }};
        --blue-2: {{ settings.color_accent_2 }};
        --radius: {{ settings.radius | at_most: 12 }}px;
        --page: {{ settings.page_width }}px;
      }
    </style>
    {{ 'rizo.css' | asset_url | stylesheet_tag: preload: true }}
    {% render 'rizo-event-head' %}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <script src="{{ 'rizo.js' | asset_url }}" defer></script>
  </head>

  <body class="route-{{ template.name | handle }}{% if template.suffix != blank %} route-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}" data-route="{{ route }}" style="--seed: {{ page_seed }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% render 'rizo-sky' %}

    {% sections 'header-group' %}

    <main id="MainContent" class="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'rizo-event-stage', layer: 'front' %}
    {% render 'cart-drawer' %}
    {% render 'search-dialog' %}
    {% render 'quick-add-dialog' %}
    <div class="toast" id="RizoToast" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="visually-hidden" data-rizo-live-region aria-live="polite" aria-atomic="true"></div>
    <div class="visually-hidden" data-cart-count-live aria-live="polite" aria-atomic="true"></div>
    <div class="visually-hidden" data-rizo-alert-region role="alert" aria-live="assertive" aria-atomic="true"></div>
  </body>
</html>
