<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-motion="{{ settings.motion_level }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <meta name="color-scheme" content="dark light">
    <link rel="canonical" href="{{ canonical_url }}">

    {% if settings.favicon != blank %}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 64, height: 64 }}" type="image/png">
    {% else %}
      <link rel="icon" href="{{ 'favicon.png' | asset_url }}" type="image/png">
    {% endif %}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} · {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} · Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} · {{ shop.name }}{% endunless -%}
    </title>
    {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {{ content_for_header }}

    <style>
      :root {
        --ink: {{ settings.color_ink }};
        --paper: {{ settings.color_paper }};
        --accent: {{ settings.color_accent }};
        --heat: {{ settings.color_accent_2 }};
        --muted: {{ settings.color_muted }};
        --radius: {{ settings.radius }}px;
        --page-width: {{ settings.page_width }}px;
      }
    </style>
    <meta name="format-detection" content="telephone=no">
    {{ 'rizo-theme.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'rizo-display.ttf' | asset_url | preload_tag: as: 'font', type: 'font/ttf', crossorigin: 'anonymous' }}
    {{ 'rizo-design.css' | asset_url | stylesheet_tag }}
    {% render 'rizo-event-head' %}
    <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
    <script src="{{ 'rizo-theme.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix != blank %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}{% if customer %} customer-logged-in{% endif %}" data-world-state="{{ settings.world_state | default: 'quiet' }}" data-texture="{{ settings.texture_level | default: 'balanced' }}" data-heritage="{% if settings.heritage_mode %}on{% else %}off{% endif %}" style="--header-stack-height:{% if settings.heritage_mode %}150px{% else %}78px{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% render 'rizo-event-stage' %}

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    {% render 'search-dialog' %}
    {% render 'quick-add-dialog' %}
    {% render 'install-guide' %}
    <div class="rizo-toast" id="RizoToast" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="rizo-live-region visually-hidden" data-rizo-live-region aria-live="polite" aria-atomic="true"></div>
    <div class="visually-hidden" data-cart-count-live aria-live="polite" aria-atomic="true"></div>
    <div class="visually-hidden" data-rizo-alert-region role="alert" aria-live="assertive" aria-atomic="true"></div>
  </body>
</html>
